{
  "schema_version": 2,
  "meta": {
    "name": "editor-notes-demo-selection-sync",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": [
      "ui_editor",
      "selection",
      "inspector",
      "workspace_frame",
      "regression",
      "screenshots"
    ],
    "target_hints": [
      "Uses the app-local editor_notes_demo shell-mounted editor surface.",
      "Proves left-rail asset selection updates collection summary, inspector fields, and app-owned summary command status without widening shared IMUI helpers.",
      "Keeps the proof at the product workflow layer: app-owned selection state, reusable inspector controls, and diagnostics-visible stable test ids."
    ],
    "env_defaults": {
      "FRET_EDITOR_NOTES_DEMO_PRESET": "default"
    }
  },
  "window": "lowest_id",
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 4 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 820.0 },
    { "type": "wait_frames", "n": 8 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "editor-notes-demo.root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.collection.summary" },
        "text": "active: Material"
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.selection.material" },
        "text": "active"
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.name" },
        "text": "Weathered Steel"
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.notes" },
        "text": "Review roughness breakup.\nValidate clear-coat against the hero shot."
      },
      "timeout_frames": 600
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "editor-notes-demo.selection.light" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.collection.summary" },
        "text": "active: Key Light"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.selection.light" },
        "text": "active"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.selection.material" },
        "text": "available"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.name" },
        "text": "Key Light A"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.notes" },
        "text": "Keep the rim subtle on close-ups.\nRevisit exposure after fog tuning."
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-status" },
        "text": "Ready to copy summary for Key Light."
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-command" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-status" },
        "text": "Copied summary: Key Light"
      },
      "timeout_frames": 240
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "editor-notes-demo.selection.camera" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.collection.summary" },
        "text": "active: Camera"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.selection.camera" },
        "text": "active"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.selection.light" },
        "text": "available"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.name" },
        "text": "ShotCam_Main"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.notes" },
        "text": "Preserve this draft across blur.\nCommit only when the sequence note is ready."
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-status" },
        "text": "Ready to copy summary for Camera."
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-command" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.summary-status" },
        "text": "Copied summary: Camera"
      },
      "timeout_frames": 240
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "editor-notes-demo.selection.material" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "editor-notes-demo.collection.summary" },
        "text": "active: Material"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "editor-notes-demo.inspector.name" },
        "text": "Weathered Steel"
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_screenshot",
      "label": "editor-notes-demo-selection-sync"
    },
    {
      "type": "capture_bundle",
      "label": "editor-notes-demo-selection-sync"
    }
  ]
}
