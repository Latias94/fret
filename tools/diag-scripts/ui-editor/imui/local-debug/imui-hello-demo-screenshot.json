{
  "schema_version": 2,
  "meta": {
    "name": "imui-hello-demo-screenshot",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["imui", "hello", "screenshot", "local-debug", "ui_editor"],
    "target_hints": [
      "Captures the tiny imui_hello_demo smoke surface without relying on app test IDs.",
      "Use this as review evidence only; it is not a promoted gate."
    ]
  },
  "window": "lowest_id",
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 4 },
    { "type": "set_window_inner_size", "width_px": 520.0, "height_px": 240.0 },
    { "type": "wait_frames", "n": 30 },
    {
      "type": "capture_bundle",
      "label": "imui-hello-demo"
    },
    {
      "type": "capture_screenshot",
      "label": "imui-hello-demo"
    }
  ]
}
