{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-item-demo-link-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "item",
      "link",
      "action_state",
      "command_dispatch",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "item",
      "FRET_UI_GALLERY_START_SECTION": "Demo"
    },
    "target_hints": [
      "Proves the Item Demo exposes a non-interactive Basic Item without focus/invoke actions.",
      "Asserts ItemRender::Link exports link semantics plus focus/invoke actions through the docs Demo row.",
      "Clicks the link-rendered Item row and requires ui_gallery.app.open to be handled by the gallery driver."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-item" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-basic" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-basic" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-basic" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-basic" },
        "action": "invoke",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link-media" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link-content" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link-actions" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" },
        "text": "Verified profile"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "focus",
      "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-item-docs-demo-sm-link" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_test_id": "ui-gallery-item-docs-demo-sm-link",
        "handled": true,
        "handled_by_driver": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "cmd.open"
      },
      "timeout_frames": 360
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-item-demo-link-action-state.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-item-demo-link-action-state"
    },
    { "type": "capture_bundle", "label": "ui-gallery-item-demo-link-action-state" }
  ]
}
