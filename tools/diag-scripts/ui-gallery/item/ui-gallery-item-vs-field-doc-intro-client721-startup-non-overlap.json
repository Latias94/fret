{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-item-vs-field-doc-intro-client721-startup-non-overlap",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "item",
      "FRET_UI_GALLERY_START_SECTION": "Item vs Field",
      "FRET_UI_GALLERY_MAIN_WINDOW_SIZE": "1083x721"
    },
    "tags": ["ui_gallery", "shadcn", "item", "layout", "text", "startup", "gate"],
    "target_hints": [
      "Starts directly on the Item docs page and focuses the Item vs Field section at the same client-height companion used by the Combobox startup text gate.",
      "Covers a non-Combobox fixed-line-box long paragraph surface so cold wrapped docs text cannot regress back to one-line startup measurement.",
      "Asserts the long docs intro owns enough measured height before the Item vs Field section title, description, and content."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-item" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-doc-page-intro" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-vs-field-title" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-vs-field-description" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-item-vs-field-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-item-vs-field-doc-intro-client721-startup-non-overlap.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-item-vs-field-doc-intro-client721-startup-non-overlap"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-item-vs-field-doc-intro-client721-startup-non-overlap"
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_non_overlapping",
        "a": { "kind": "test_id", "id": "ui-gallery-doc-page-intro" },
        "b": { "kind": "test_id", "id": "ui-gallery-item-vs-field-title" },
        "eps_px": 0.5
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-item-vs-field-title" },
        "b": { "kind": "test_id", "id": "ui-gallery-doc-page-intro" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 16.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-item-vs-field-description" },
        "b": { "kind": "test_id", "id": "ui-gallery-item-vs-field-title" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 8.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-item-vs-field-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-item-vs-field-description" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 8.0,
        "eps_px": 1.0
      }
    }
  ]
}
