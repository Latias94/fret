      "FRET_UI_GALLERY_START_PAGE": "sidebar",
      "FRET_UI_GALLERY_START_SECTION": "AppSidebar"
    },
    "target_hints": [
      "Proves the Sidebar AppSidebar team switcher DropdownMenu keeps the authored SidebarMenuButton as the trigger relation/action source.",
      "Proves selecting a team row closes the menu, clears the trigger relation edge, and returns focus to the trigger.",
      "Proves the Sidebar AppSidebar user/account DropdownMenu exposes its account rows as invokable menu items and restores focus on Escape."
    ]
