    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sidebar-app-sidebar-team-trigger" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sidebar-app-sidebar-team-trigger" },
