      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "sidebar",
      "dropdown",
      "overlay",
      "focus",
      "relation",
      "action_state",
      "mechanism_harness",
      "runtime"
