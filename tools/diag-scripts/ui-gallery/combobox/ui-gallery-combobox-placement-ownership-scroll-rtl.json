{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-placement-ownership-scroll-rtl",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png",
      "diag.overlay_placement_trace"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "combobox",
      "FRET_UI_GALLERY_START_SECTION": "ui-gallery-combobox-placement-ownership-docsec"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "combobox",
      "overlay",
      "scroll_container",
      "rtl",
      "hit_test"
    ],
    "target_hints": [
      "Starts directly on the Combobox Placement Ownership fixture.",
      "Opens an RTL Combobox whose trigger is inside a clipped ScrollArea while its popover extends below the ScrollArea viewport.",
      "Clicks an option that is outside the ScrollArea viewport but inside the overlay root, proving overlay placement and hit-testing are not clipped by the trigger's scroll container."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 900.0, "height_px": 900.0 },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-combobox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-docsec-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-trigger" },
      "delta_y": -500.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-trigger" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-input" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-content" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "anchored_panel",
        "anchor_test_id": "ui-gallery-combobox-placement-ownership-trigger",
        "content_test_id": "ui-gallery-combobox-placement-ownership-content",
        "preferred_side": "bottom",
        "chosen_side": "bottom",
        "flipped": false,
        "side_offset_px": 6.0,
        "side_offset_eps_px": 0.25
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-trigger" },
        "a_metric": "right",
        "b_metric": "right",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-scroll-viewport" },
        "a_metric": "bottom",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 80.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-item-release" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-scroll-viewport" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-item-release" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-input" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-listbox" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-input" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-item-release" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "selected": true,
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-placement-ownership-item-release" }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-combobox-placement-ownership-scroll-rtl.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-combobox-placement-ownership-scroll-rtl"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-combobox-placement-ownership-scroll-rtl"
    }
  ]
}
