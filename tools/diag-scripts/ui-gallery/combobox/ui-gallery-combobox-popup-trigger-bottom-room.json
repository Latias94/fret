{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-popup-trigger-bottom-room",
    "required_capabilities": [
      "diag.script_v2",
      "diag.overlay_placement_trace",
      "diag.screenshot_png"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "combobox",
      "FRET_UI_GALLERY_START_SECTION": "Popup"
    },
    "tags": ["ui_gallery", "shadcn", "combobox", "popup", "trigger", "bottom_room"],
    "target_hints": [
      "Starts on the Combobox Popup section in a taller viewport.",
      "Keeps enough space below the trigger so collision solving should preserve bottom placement.",
      "Asserts shadcn v4 ComboboxContent sideOffset parity at 6px."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 1080.0 },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-combobox" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "anchored_panel",
        "anchor_test_id": "ui-gallery-combobox-popup-trigger",
        "content_test_id": "ui-gallery-combobox-popup-content",
        "preferred_side": "bottom",
        "chosen_side": "bottom",
        "flipped": false,
        "side_offset_px": 6.0,
        "side_offset_eps_px": 0.25
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "eq",
        "value_px": 6.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
        "metric": "left",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
        "metric": "width",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" },
        "min_w_px": 240.0,
        "min_h_px": 160.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" },
        "max_w_px": 280.0,
        "max_h_px": 190.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "min_w_px": 230.0,
        "min_h_px": 30.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "max_w_px": 260.0,
        "max_h_px": 34.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.label" },
        "min_w_px": 40.0,
        "min_h_px": 18.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.label" },
        "max_w_px": 220.0,
        "max_h_px": 22.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "metric": "center_y",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "metric": "left",
        "comparison": "eq",
        "value_px": 32.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "min_w_px": 15.0,
        "min_h_px": 15.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "max_w_px": 17.0,
        "max_h_px": 17.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "metric": "center_y",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "metric": "left",
        "comparison": "eq",
        "value_px": 8.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "element_effective_opacity_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "opacity": 0.0,
        "eps": 0.01
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-svelte" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "metric": "top",
        "comparison": "eq",
        "value_px": 32.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-combobox-popup-trigger-bottom-room-open.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-combobox-popup-trigger-bottom-room-open"
    },
    { "type": "capture_bundle", "label": "ui-gallery-combobox-popup-trigger-bottom-room-open" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
        "padding_px": 0.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-content" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "element_effective_opacity_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next.checkmark" },
        "opacity": 1.0,
        "eps": 0.01
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "element_effective_opacity_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-svelte.checkmark" },
        "opacity": 0.0,
        "eps": 0.01
      }
    },
    { "type": "capture_bundle", "label": "ui-gallery-combobox-popup-trigger-bottom-room-selected-open" },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    }
  ]
}
