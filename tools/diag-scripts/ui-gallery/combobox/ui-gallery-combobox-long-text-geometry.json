{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-long-text-geometry",
    "required_capabilities": [
      "diag.script_v2",
      "diag.overlay_placement_trace",
      "diag.screenshot_png"
    ],
    "env_defaults": {
      "FRET_TEXT_FONT_TRACE_ALL": "1",
      "FRET_UI_GALLERY_START_PAGE": "combobox",
      "FRET_UI_GALLERY_START_SECTION": "Long Text"
    },
    "tags": ["ui_gallery", "shadcn", "combobox", "long_text", "truncation"],
    "target_hints": [
      "Starts on the Combobox Long Text fixture.",
      "Asserts the selected trigger label is constrained before the chevron.",
      "Opens the popup and asserts the long option label remains within its row before the checkmark."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "render_text_font_trace_entries_matching_ge",
        "min": 1,
        "text_contains": "Enterprise Observability",
        "font": "ui",
        "wrap": "none",
        "overflow": "ellipsis",
        "missing_glyphs": 0
      },
      "timeout_frames": 240
    },
    { "type": "set_window_inner_size", "width_px": 900.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger" },
        "max_w_px": 222.0,
        "max_h_px": 36.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-label" },
        "min_w_px": 110.0,
        "min_h_px": 18.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger.chrome" },
        "metric": "width",
        "comparison": "le",
        "value_px": -40.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-icon" },
        "metric": "right",
        "comparison": "le",
        "value_px": -4.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-icon" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger.chrome" },
        "metric": "right",
        "comparison": "ge",
        "value_px": -28.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger-label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger.chrome" },
        "metric": "center_y",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-listbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "anchored_panel",
        "anchor_test_id": "ui-gallery-combobox-long-text-trigger",
        "content_test_id": "ui-gallery-combobox-long-text-content",
        "preferred_side": "bottom",
        "chosen_side": "bottom",
        "flipped": false,
        "side_offset_px": 6.0,
        "side_offset_eps_px": 0.25
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-listbox" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_max_size",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform.label" },
        "max_w_px": 192.0,
        "max_h_px": 22.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform.label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform" },
        "metric": "center_y",
        "comparison": "eq",
        "value_px": 0.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform.label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform" },
        "metric": "left",
        "comparison": "eq",
        "value_px": 32.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform.label" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform" },
        "metric": "width",
        "comparison": "le",
        "value_px": -40.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_delta",
        "a": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform.checkmark" },
        "b": { "kind": "test_id", "id": "ui-gallery-combobox-long-text-item-enterprise-observability-platform" },
        "metric": "left",
        "comparison": "eq",
        "value_px": 8.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-combobox-long-text-open.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-combobox-long-text-open"
    },
    { "type": "capture_bundle", "label": "ui-gallery-combobox-long-text-open" }
  ]
}
