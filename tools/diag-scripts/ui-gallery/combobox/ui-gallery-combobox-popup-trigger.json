{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-popup-trigger",
    "required_capabilities": [
      "diag.script_v2",
      "diag.overlay_placement_trace",
      "diag.screenshot_png"
    ],
    "tags": ["ui_gallery", "shadcn", "combobox", "popup", "trigger"],
    "target_hints": [
      "Navigates to the Combobox popup-trigger example.",
      "Keeps the trigger near the viewport bottom so collision solving must flip the popup to top.",
      "Asserts shadcn v4 ComboboxContent sideOffset parity at 6px."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 20 },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "combobox" },
    { "type": "wait_frames", "n": 2 },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-combobox" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-combobox" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" },
      "delta_y": -360.0,
      "require_fully_within_container": true,
      "padding_px": 16.0,
      "timeout_frames": 1800
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-trigger" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "anchored_panel",
        "anchor_test_id": "ui-gallery-combobox-popup-trigger",
        "content_test_id": "ui-gallery-combobox-popup-listbox",
        "chosen_side": "top",
        "flipped": true,
        "side_offset_px": 6.0,
        "side_offset_eps_px": 0.25
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-combobox-popup-trigger-open.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-combobox-popup-trigger-open"
    },
    { "type": "capture_bundle", "label": "ui-gallery-combobox-popup-trigger-open" },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-item-next" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-popup-listbox" }
      },
      "timeout_frames": 600
    },

    { "type": "capture_bundle", "label": "ui-gallery-combobox-popup-trigger" }
  ]
}
