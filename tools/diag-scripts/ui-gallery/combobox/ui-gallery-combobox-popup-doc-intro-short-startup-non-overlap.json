{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-popup-doc-intro-short-startup-non-overlap",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "combobox",
      "FRET_UI_GALLERY_START_SECTION": "Popup",
      "FRET_UI_GALLERY_MAIN_WINDOW_SIZE": "663x311"
    },
    "tags": ["ui_gallery", "shadcn", "combobox", "popup", "layout", "text", "startup", "gate"],
    "target_hints": [
      "Starts directly on the focused Combobox Popup doc section at a short startup window derived from the observed 994x466 screenshot on a 1.5x scale display.",
      "Captures the early startup frames before any manual resize recovery and asserts the long docs intro owns enough measured height before the Popup section title."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-combobox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-doc-page-intro" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "docsec-popup-title" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "docsec-popup-description" }
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-combobox-popup-doc-intro-short-startup-non-overlap.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-combobox-popup-doc-intro-short-startup-non-overlap"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-combobox-popup-doc-intro-short-startup-non-overlap"
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "docsec-popup-title" },
        "b": { "kind": "test_id", "id": "ui-gallery-doc-page-intro" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 16.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_metric_pair_delta",
        "a": { "kind": "test_id", "id": "docsec-popup-description" },
        "b": { "kind": "test_id", "id": "docsec-popup-title" },
        "a_metric": "top",
        "b_metric": "bottom",
        "comparison": "ge",
        "value_px": 8.0,
        "eps_px": 1.0
      }
    }
  ]
}
