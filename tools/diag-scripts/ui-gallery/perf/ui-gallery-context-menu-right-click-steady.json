{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-context-menu-right-click-steady",
    "required_capabilities": ["diag.script_v2"],
    "target_hints": [
      "Requires fret-ui-gallery with the gallery-dev feature because the overlay preview page is dev-only."
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "overlay"
    }
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" } },
    { "type": "wait_frames", "n": 10 },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    { "type": "click", "button": "right", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-item-action" }
      },
      "timeout_frames": 180
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 4 },

    { "type": "reset_diagnostics" },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    { "type": "click", "button": "right", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-item-action" }
      },
      "timeout_frames": 180
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-context-item-action" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-item-action" }
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_bundle", "label": "ui-gallery-context-action-steady" },
    { "type": "wait_frames", "n": 2 }
  ]
}
