{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-inspector-torture-scroll",
    "required_capabilities": ["diag.script_v2"],
    "required_launch_features": ["gallery-dev"],
    "tags": ["ui-gallery", "perf", "inspector", "scroll", "transition"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "intro"
    },
    "target_hints": [
      "Starts from the lightweight intro page so the nav-search/page-switch transition probe does not inherit the diagnostics default overlay page.",
      "Measures the transition into inspector_torture before the scroll stress; use ui-gallery-inspector-torture-scroll-direct-entry for the steady direct-entry scroll surface."
    ]
  },
  "steps": [
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-nav-search",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "button": "left",
      "target": {
        "id": "ui-gallery-nav-search",
        "kind": "test_id"
      },
      "type": "click"
    },
    {
      "text": "inspector torture",
      "type": "type_text"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-nav-inspector-torture",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "button": "left",
      "target": {
        "id": "ui-gallery-nav-inspector-torture",
        "kind": "test_id"
      },
      "type": "click"
    },
    {
      "target": {
        "id": "ui-gallery-nav-search",
        "kind": "test_id"
      },
      "type": "move_pointer"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-inspector-root",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-inspector-row-0-label",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "target": {
        "id": "ui-gallery-inspector-row-0-label",
        "kind": "test_id"
      },
      "type": "move_pointer"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "delta_x": 0.0,
      "delta_y": -240.0,
      "target": {
        "id": "ui-gallery-inspector-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 5,
      "type": "wait_frames"
    },
    {
      "label": "ui-gallery-inspector-torture-scroll",
      "type": "capture_bundle"
    }
  ]
}
