{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-overlay-pointer-move-steady",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["ui_gallery", "overlay", "perf", "pointer_move", "steady"],
    "target_hints": [
      "Perf probe: pointer-move dispatch/hit-test under overlay stacks (dispatch snapshot cost is included in dispatch time)."
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "overlay"
    }
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" }
      },
      "timeout_frames": 240
    },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" } },
    { "type": "wait_frames", "n": 10 },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-popover-trigger" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-popover-close" }
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 8 },

    { "type": "reset_diagnostics" },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-overlay-underlay" } },
    { "type": "wait_frames", "n": 1 },
    {
      "type": "move_pointer_sweep",
      "target": { "kind": "test_id", "id": "ui-gallery-overlay-underlay" },
      "delta_x": 900.0,
      "delta_y": 420.0,
      "steps": 96
    },
    { "type": "wait_frames", "n": 2 },

    { "type": "capture_bundle", "label": "ui-gallery-overlay-pointer-move-steady", "max_snapshots": 240 },
    { "type": "wait_frames", "n": 2 },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-overlay-underlay" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-popover-dismissed" }
      },
      "timeout_frames": 240
    },

    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 }
  ]
}
