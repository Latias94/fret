{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-ai", "gallery-chart", "gallery-dev", "gallery-web-ime-harness"],
    "name": "UI gallery: AI transcript non-retained torture scroll steady",
    "tags": ["ui-gallery", "perf", "ai-elements", "transcript", "non-retained", "virtual-list", "steady"],
    "required_capabilities": ["diag.script_v2"],
    "target_hints": [
      "Navigates to the AI Transcript Torture page, waits for the deterministic transcript model, then resets diagnostics before measuring scroll and append interactions.",
      "Use this script for steady interaction attribution; use ui-gallery-ai-transcript-torture-scroll.json when page mount, screenshot, and layout sidecar evidence are needed."
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_AI_TRANSCRIPT_LEN": "240",
      "FRET_UI_GALLERY_AI_TRANSCRIPT_VARIABLE_HEIGHT": "1"
    }
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "reset_diagnostics" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 1000.0 },
    { "type": "wait_frames", "n": 20 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "ai transcript" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-ai-transcript-torture" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-ai-transcript-torture" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-root" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_numeric_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-messages-len" },
        "field": "value",
        "value": 240.0,
        "eps": 0.01
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 20 },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 1 },

    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-root" }
    },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-root" },
      "delta_y": 240.0
    },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": 240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": 240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": 240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": 240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": 240.0 },
    { "type": "wait_frames", "n": 4 },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-append" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_numeric_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-messages-len" },
        "field": "value",
        "value": 340.0,
        "eps": 0.01
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }
      },
      "timeout_frames": 600
    },

    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": -240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": -240.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-ai-transcript-row-0" }, "delta_y": -240.0 },
    { "type": "wait_frames", "n": 4 },

    {
      "type": "capture_bundle",
      "label": "ui-gallery-ai-transcript-torture-scroll-steady"
    }
  ]
}
