{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-code-view-torture-mount",
    "required_capabilities": ["diag.script_v2"],
    "required_launch_features": ["gallery-dev"],
    "tags": ["ui-gallery", "perf", "code-view", "mount", "transition"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "intro"
    },
    "target_hints": [
      "Starts from the lightweight intro page so the nav-search/page-switch transition probe does not inherit the diagnostics default overlay page.",
      "Measures the transition into code_view_torture; use ui-gallery-code-view-torture-mount-direct-entry for the steady direct-entry mount surface."
    ]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "text": "code_view_torture",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-code-view-torture" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 1 },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-code-view-torture" },
      "stable_frames": 3,
      "max_move_px": 2.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-code-view-torture" }
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },

    { "type": "capture_bundle", "label": "ui-gallery-code-view-torture-mount" }
  ]
}
