{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-inspector-torture-scroll-direct-entry",
    "required_capabilities": ["diag.script_v2"],
    "required_launch_features": ["gallery-dev"],
    "tags": [
      "ui-gallery",
      "perf",
      "inspector",
      "scroll",
      "direct-entry",
      "steady"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "inspector_torture",
      "FRET_UI_GALLERY_INSPECTOR_LEN": "96",
      "FRET_UI_GALLERY_INSPECTOR_KEEP_ALIVE": "64",
      "FRET_UI_GALLERY_VIEW_CACHE_SHELL": "1"
    },
    "target_hints": [
      "Starts directly on the inspector_torture page so nav search and page-switch transitions do not dominate the probe.",
      "Measures the retained inspector scroll surface after gallery chrome and font state settle."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-inspector-row-0-label" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-row-0" }
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" }
      },
      "timeout_frames": 120
    },
    { "type": "wait_frames", "n": 2 },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-row-0-label" }
    },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-inspector-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 5 },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-inspector-torture-scroll-direct-entry"
    }
  ]
}
