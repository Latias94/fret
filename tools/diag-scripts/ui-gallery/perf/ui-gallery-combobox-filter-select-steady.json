{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-combobox-filter-select-steady",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["ui-gallery", "perf", "shadcn", "combobox", "filter", "select", "steady"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "combobox"
    },
    "target_hints": [
      "Starts on the Combobox page to measure the long-list searchable combobox without Gallery navigation search.",
      "Exercises open, query filtering, and item commit after warmup."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-combobox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-content-scroll" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-trigger" },
      "delta_x": 0.0,
      "delta_y": -720.0,
      "padding_px": 8.0,
      "require_fully_within_window": true,
      "require_fully_within_container": true,
      "timeout_frames": 900
    },
    {
      "type": "ensure_visible",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-trigger" },
      "padding_px": 4.0,
      "within_window": true,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-trigger" },
      "button": "left",
      "stable_frames": 2,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-input" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-input" },
      "text": "249",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-listbox" }
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 4 },
    { "type": "reset_diagnostics" },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-trigger" },
      "button": "left",
      "stable_frames": 2,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-input" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-input" },
      "text": "249",
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-input" },
        "text": "249"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists_under",
        "scope": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-listbox" },
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-item-249" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-item-249" },
      "button": "left",
      "stable_frames": 2,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-combobox-long-list-listbox" }
      },
      "timeout_frames": 240
    },
    { "type": "capture_bundle", "label": "ui-gallery-combobox-filter-select-steady" },
    { "type": "wait_frames", "n": 2 }
  ]
}
