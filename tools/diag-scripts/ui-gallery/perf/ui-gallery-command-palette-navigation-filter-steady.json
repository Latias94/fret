{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-command-palette-navigation-filter-steady",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["ui-gallery", "perf", "shadcn", "command", "filter", "keyboard", "steady"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "command"
    },
    "target_hints": [
      "Starts on the Command page to measure the command palette itself, not Gallery navigation search.",
      "Exercises query filtering and repeated keyboard navigation after warmup."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-command" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-content-scroll" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "delta_x": 0.0,
      "delta_y": -720.0,
      "padding_px": 8.0,
      "require_fully_within_window": true,
      "require_fully_within_container": true,
      "timeout_frames": 600
    },
    {
      "type": "ensure_visible",
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "padding_px": 4.0,
      "within_window": true,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "stable_frames": 2,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" }
      },
      "timeout_frames": 240
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "text": "toggle",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "text": "",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    { "type": "reset_diagnostics" },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
      "text": "toggle",
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
        "text": "toggle"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "active_item_is",
        "container": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
        "item": { "kind": "test_id", "id": "ui-gallery-command-behavior-item-toggle-sidebar" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "arrow_down" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "active_item_is",
        "container": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
        "item": { "kind": "test_id", "id": "ui-gallery-command-behavior-item-toggle-terminal" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "home" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "active_item_is",
        "container": { "kind": "test_id", "id": "ui-gallery-command-behavior-input" },
        "item": { "kind": "test_id", "id": "ui-gallery-command-behavior-item-toggle-sidebar" }
      },
      "timeout_frames": 240
    },
    { "type": "capture_bundle", "label": "ui-gallery-command-palette-navigation-filter-steady" },
    { "type": "wait_frames", "n": 2 }
  ]
}
