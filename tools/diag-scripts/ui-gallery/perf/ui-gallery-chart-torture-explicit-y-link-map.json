{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-chart"],
    "env_defaults": {
      "FRET_UI_GALLERY_CHART_TORTURE_EXPLICIT_Y_LINK_MAP": "1"
    },
    "tags": ["ui_gallery", "chart", "retained", "linking", "explicit_axis_map", "adr_0301"],
    "target_hints": [
      "Starts from the retained Chart Torture page with an explicit Y-axis link map enabled.",
      "Proves ADR 0301 explicit host mapping can publish an otherwise ambiguous multi-series Y domain window to ChartCanvasOutput."
    ]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
    },
    {
      "type": "press_key",
      "key": "a",
      "modifiers": { "ctrl": true }
    },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "chart torture" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "ensure_visible",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-chart-torture" },
      "within_window": true,
      "padding_px": 8.0,
      "timeout_frames": 600
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-chart-torture" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-chart-torture-root" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/engine_present",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/output_model/domain_windows_count",
        "value": 1
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/output_model/y_explicit_domain_window/present",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/output_model/y_explicit_domain_window/min_milli",
        "value": -250
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/output_model/y_explicit_domain_window/max_milli",
        "value": 750
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/chart_torture/runtime_oracles/y_output_model_domain_matches_explicit_fixture",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-chart-torture-explicit-y-link-map"
    }
  ]
}
