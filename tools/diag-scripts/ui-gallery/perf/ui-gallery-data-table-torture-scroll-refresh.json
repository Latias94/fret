{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-data-table-torture-scroll-refresh",
    "required_capabilities": ["diag.script_v2"],
    "required_launch_features": ["gallery-dev"],
    "tags": [
      "ui-gallery",
      "perf",
      "data-table",
      "torture",
      "scroll",
      "direct-entry",
      "steady"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "data_table_torture"
    },
    "target_hints": [
      "Starts directly on data_table_torture so nav search and page-switch transitions do not dominate the probe.",
      "Measures the steady data-table scroll refresh surface after gallery chrome and font state settle."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-data-table-torture" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-data-table-torture-root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-data-table-row-0" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-data-table-torture-reset-state" }
    },
    { "type": "wait_frames", "n": 2 },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-data-table-row-0" }
    },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-data-table-torture-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 5 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-data-table-torture-root" },
      "delta_x": 0.0,
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 5 },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-data-table-torture-root" },
      "delta_x": 0.0,
      "delta_y": 240.0
    },
    { "type": "wait_frames", "n": 5 },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-data-table-torture-scroll-refresh"
    }
  ]
}
