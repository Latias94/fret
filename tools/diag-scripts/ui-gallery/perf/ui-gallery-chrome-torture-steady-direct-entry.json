{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-chrome-torture-steady-direct-entry",
    "required_capabilities": ["diag.script_v2"],
    "required_launch_features": [
      "gallery-dev",
      "gallery-ai",
      "gallery-chart",
      "gallery-web-ime-harness"
    ],
    "tags": [
      "ui-gallery",
      "perf",
      "chrome",
      "torture",
      "direct-entry",
      "steady"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "chrome_torture"
    },
    "target_hints": [
      "Starts directly on chrome_torture so nav search and page-switch transitions do not dominate the probe.",
      "Captures the steady direct-entry chrome surface after the gallery chrome and font state settle."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-chrome-torture" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-chrome-torture-root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 2 },
    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-chrome-btn-1" } },
    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-chrome-btn-2" } },
    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-chrome-btn-3" } },
    { "type": "wait_frames", "n": 2 },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-chrome-btn-1" } },
    { "type": "press_key", "key": "tab" },
    { "type": "press_key", "key": "tab" },
    { "type": "press_key", "key": "tab" },
    { "type": "wait_frames", "n": 30 },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-chrome-torture-steady-direct-entry"
    },
    { "type": "wait_frames", "n": 2 }
  ]
}
