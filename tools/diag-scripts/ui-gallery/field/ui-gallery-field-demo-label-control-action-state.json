{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-field-demo-label-control-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "field",
      "label",
      "relation",
      "action_state",
      "text_input",
      "checkbox",
      "textarea",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "field",
      "FRET_UI_GALLERY_START_SECTION": "Demo"
    },
    "target_hints": [
      "Proves FieldLabel::for_control(...) owns explicit controls/labelled_by relations in the Field Demo.",
      "Asserts Field labels remain text nodes without focus/set-value actions while concrete controls keep their own actions.",
      "Clicks labels to prove text inputs receive focus and the checkbox toggles through the label-control forwarding path."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-field" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "role": "text"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "text": "Name on Card"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "action": "set_value",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name-label" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "Ada Lovelace" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-card-name" },
        "text": "Ada Lovelace"
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" },
        "role": "checkbox"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" },
        "state": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping-label" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping-label" }
      }
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping-label" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping-label" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping-label" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-same-as-shipping" },
        "state": "false"
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments-label" },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments-label" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-comments-label" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments-label" }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments-label" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "Looks good." },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-field-demo-comments" },
        "text": "Looks good."
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-field-demo-label-control-action-state.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-field-demo-label-control-action-state"
    },
    { "type": "capture_bundle", "label": "ui-gallery-field-demo-label-control-action-state" }
  ]
}
