{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-command-docs-demo-long-query-text",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "env_defaults": {
      "FRET_TEXT_FONT_TRACE_ALL": "1",
      "FRET_UI_GALLERY_START_PAGE": "command",
      "FRET_UI_GALLERY_START_SECTION": "Demo"
    },
    "tags": ["ui_gallery", "shadcn", "command", "text_input", "long_text"],
    "target_hints": [
      "Starts on the Command docs demo palette.",
      "Injects a long query into the cmdk-style command input.",
      "Asserts TextInput paint-time overflow, offset, visible viewport clipping, and text-height coverage."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 1200.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1280.0,
        "height_px": 1220.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-command" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-content" },
        "min_w_px": 240.0,
        "min_h_px": 120.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-content-scroll" }
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-content" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 760.0, "height_px": 640.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 760.0,
        "height_px": 660.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
        "min_w_px": 120.0,
        "min_h_px": 28.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 900
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
      "text": "enterprise-command-palette-observability-workflow-with-extra-long-search-query",
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "render_text_font_trace_entries_matching_ge",
        "min": 1,
        "text_contains": "enterprise-command-palette-observability",
        "font": "ui",
        "wrap": "none",
        "overflow": "clip",
        "missing_glyphs": 0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_len_ge",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
        "min_len_bytes": 70
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
        "padding_px": 8.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_ime_cursor_area_within_bounds",
        "target": { "kind": "test_id", "id": "ui-gallery-command-docs-demo-input" },
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_overflow_is",
        "overflowing": true,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_offset_in_range",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_visible_text_within_viewport",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_viewport_covers_text_height",
        "eps_px": 1.0
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-command-docs-demo-long-query-text.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-command-docs-demo-long-query-text"
    },
    { "type": "capture_bundle", "label": "ui-gallery-command-docs-demo-long-query-text" }
  ]
}
