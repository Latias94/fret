{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-command-palette-disabled-focusable-keyboard-suppression",
    "required_capabilities": [
      "diag.script_v2"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "command",
      "keyboard",
      "active_descendant",
      "semantics",
      "a11y",
      "action_state",
      "regression_pack"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "command",
      "FRET_UI_GALLERY_STATUS_BAR": "1"
    },
    "target_hints": [
      "Proves a CommandPalette disabled-but-focusable item remains reachable through active-descendant navigation.",
      "Gates that disabled CommandPalette rows expose disabled=true and invoke=false while Enter does not dispatch the item's action."
    ]
  },
  "steps": [
    {
      "type": "reset_diagnostics"
    },
    {
      "type": "press_key",
      "key": "escape"
    },
    {
      "type": "wait_frames",
      "n": 2
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-page-command"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-content-scroll"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-input"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": {
        "kind": "test_id",
        "id": "ui-gallery-content-scroll"
      },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-command-behavior-input"
      },
      "delta_x": 0.0,
      "delta_y": -720.0,
      "padding_px": 4.0,
      "require_fully_within_window": true,
      "timeout_frames": 600,
      "require_fully_within_container": true
    },
    {
      "type": "ensure_visible",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-command-behavior-input"
      },
      "padding_px": 4.0,
      "within_window": true,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-command-behavior-input"
      }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "active_item_is",
        "container": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-input"
        },
        "item": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-open-project"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-legacy-export"
        },
        "disabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-legacy-export"
        },
        "action": "invoke",
        "enabled": false
      }
    },
    {
      "type": "press_key",
      "key": "arrow_down"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "active_item_is",
        "container": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-input"
        },
        "item": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-deploy-api"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-deploy-api"
        },
        "disabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-deploy-api"
        },
        "action": "invoke",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-last-action"
        },
        "text": "Last action: <none>"
      }
    },
    {
      "type": "scroll_into_view",
      "container": {
        "kind": "test_id",
        "id": "ui-gallery-content-scroll"
      },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-command-behavior-item-deploy-api"
      },
      "delta_x": 0.0,
      "delta_y": -160.0,
      "padding_px": 4.0,
      "require_fully_within_window": true,
      "timeout_frames": 600,
      "require_fully_within_container": true
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-command-palette-disabled-focusable-active-descendant"
    },
    {
      "type": "press_key",
      "key": "enter"
    },
    {
      "type": "wait_frames",
      "n": 6
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "active_item_is",
        "container": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-input"
        },
        "item": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-item-deploy-api"
        }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-command-behavior-last-action"
        },
        "text": "Last action: <none>"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "ready"
      }
    },
    {
      "type": "scroll_into_view",
      "container": {
        "kind": "test_id",
        "id": "ui-gallery-content-scroll"
      },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-command-behavior-item-deploy-api"
      },
      "delta_x": 0.0,
      "delta_y": -160.0,
      "padding_px": 4.0,
      "require_fully_within_window": true,
      "timeout_frames": 600,
      "require_fully_within_container": true
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-command-palette-disabled-focusable-keyboard-suppression"
    }
  ]
}
