{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-button-link-render",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "button",
      "link",
      "render",
      "action_state",
      "command_dispatch",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "button",
      "FRET_UI_GALLERY_START_SECTION": "As Link / As Child (Semantic)"
    },
    "target_hints": [
      "Proves ButtonRender::Link exports semantic link role on the button-owned render surface.",
      "Asserts the semantic-link button exposes focus and invoke actions with a deterministic command handler.",
      "Activates the link-rendered button without launching a browser during diagnostics runs."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-button" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-button-link-semantic-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-button-render-link-row" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link-row" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link.chrome" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
        "text": "Login"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "focus",
      "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "enter" },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_kind": "keyboard",
        "handled": true,
        "handled_by_driver": true,
        "started_from_focus": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "cmd.open"
      },
      "timeout_frames": 360
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-button-render-link" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_kind": "pointer",
        "source_test_id": "ui-gallery-button-render-link",
        "handled": true,
        "handled_by_driver": true
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-button-link-render.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-button-link-render"
    },
    { "type": "capture_bundle", "label": "ui-gallery-button-link-render" }
  ]
}
