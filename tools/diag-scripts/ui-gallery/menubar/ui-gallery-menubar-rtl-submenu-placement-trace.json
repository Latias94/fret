{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-menubar-rtl-submenu-placement-trace",
    "required_capabilities": [
      "diag.script_v2",
      "diag.overlay_placement_trace",
      "diag.screenshot_png"
    ],
    "tags": ["ui_gallery", "shadcn", "menubar", "submenu", "placement", "rtl"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "menubar",
      "FRET_UI_GALLERY_START_SECTION": "RTL"
    },
    "target_hints": [
      "Starts on the Menubar RTL section in a wide viewport.",
      "Opens the RTL File menu and hovers the Share submenu trigger.",
      "Asserts logical inline-end submenu placement resolves to the physical left in RTL."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1440.0, "height_px": 900.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-menubar" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-menubar-rtl-file" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-menubar-rtl-file" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-menubar-rtl-more" }
      },
      "timeout_frames": 600
    },
    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-menubar-rtl-more" }
    },
    { "type": "wait_frames", "n": 12 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-menubar-rtl-sub-alpha" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "placed_rect",
        "anchor_test_id": "ui-gallery-menubar-rtl-more",
        "chosen_side": "left"
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-menubar-rtl-submenu-placement-trace.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-menubar-rtl-submenu-placement-trace"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-menubar-rtl-submenu-placement-trace"
    }
  ]
}
