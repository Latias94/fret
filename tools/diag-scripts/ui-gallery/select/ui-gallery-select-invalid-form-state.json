{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Select invalid form-state semantics",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "select",
      "FRET_UI_GALLERY_START_SECTION": "ui-gallery-select-invalid"
    },
    "tags": ["ui_gallery", "shadcn", "select", "semantics", "invalid", "form-state"],
    "target_hints": [
      "Starts directly on the Select page and invalid section.",
      "Verifies that invalid form-state semantics live on the concrete Select trigger combobox and clear after committing a value."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1120.0,
        "height_px": 780.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "role": "combo_box"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "invalid": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "required": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-error" }
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-select-invalid-before-commit"
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-item-apple" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-item-apple" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "select-scroll-viewport" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "invalid": null
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "required": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-error" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-select-invalid-trigger" },
        "text": "Apple"
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-select-invalid-after-commit"
    },
    { "type": "capture_bundle", "label": "ui-gallery-select-invalid-form-state" }
  ]
}
