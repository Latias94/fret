{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-select-demo-open-layout",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "select",
      "desktop",
      "layout",
      "overlay"
    ],
    "target_hints": [
      "Navigates to the Select page and opens the minimal shadcn demo.",
      "Captures a layout sidecar, screenshot, and bundle for the open popup shell so Select can be fed into parity-discovery.",
      "Keeps the trigger and popup shell on stable test-id anchors instead of pixel coordinates."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1440.0, "height_px": 900.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "button": "left"
    },
    {
      "type": "press_key",
      "key": "a",
      "modifiers": { "ctrl": true, "alt": false, "meta": false, "shift": false },
      "repeat": false
    },
    {
      "type": "press_key",
      "key": "backspace",
      "modifiers": { "ctrl": false, "alt": false, "meta": false, "shift": false },
      "repeat": false
    },
    {
      "type": "type_text",
      "text": "select"
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-select" },
      "delta_y": -240.0,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-select" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-select" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-select-demo-content" },
      "delta_y": -180.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 1200
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-select-shadcn-demo-trigger"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-select-shadcn-demo-trigger"
      },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "select-scroll-viewport" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "select-scroll-viewport" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "select-scroll-viewport" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    { "type": "capture_layout_sidecar", "label": "ui-gallery-select-demo-open.layout" },
    { "type": "capture_screenshot", "label": "ui-gallery-select-demo-open" },
    { "type": "capture_bundle", "label": "ui-gallery-select-demo-open" }
  ]
}
