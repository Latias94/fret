{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-select-demo-open-layout",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png",
      "diag.overlay_placement_trace"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "select",
      "FRET_UI_GALLERY_START_SECTION": "ui-gallery-select-demo"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "select",
      "desktop",
      "layout",
      "overlay"
    ],
    "target_hints": [
      "Starts directly on the Select page with the minimal shadcn demo section mounted.",
      "Opens the default item-aligned Select popup and verifies placed-rect ownership through trigger and listbox test-id endpoints.",
      "Resizes the window while open to gate popup bounds stability and window containment."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1440.0, "height_px": 900.0 },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-select" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select-demo-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-select-shadcn-demo-trigger"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-trigger" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-trigger" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-select-shadcn-demo-trigger"
      },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "placed_rect",
        "anchor_test_id": "ui-gallery-select-shadcn-demo-trigger",
        "content_test_id": "ui-gallery-select-shadcn-demo-listbox"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-trigger" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-trigger" }
      },
      "timeout_frames": 240
    },
    { "type": "set_window_inner_size", "width_px": 720.0, "height_px": 420.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "placed_rect",
        "anchor_test_id": "ui-gallery-select-shadcn-demo-trigger",
        "content_test_id": "ui-gallery-select-shadcn-demo-listbox"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" },
        "padding_px": 2.0,
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-select-shadcn-demo-listbox" },
      "stable_frames": 4,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    { "type": "capture_layout_sidecar", "label": "ui-gallery-select-demo-open.layout" },
    { "type": "capture_screenshot", "label": "ui-gallery-select-demo-open" },
    { "type": "capture_bundle", "label": "ui-gallery-select-demo-open" }
  ]
}
