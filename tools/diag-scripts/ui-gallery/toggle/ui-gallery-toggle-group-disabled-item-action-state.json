{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: ToggleGroup disabled item action-state",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "toggle_group",
      "FRET_UI_GALLERY_START_SECTION": "Disabled Item Action-State (Fret)"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "toggle_group",
      "semantics",
      "checked-state",
      "disabled",
      "action-state",
      "roving_focus"
    ],
    "target_hints": [
      "Starts directly on the Toggle Group page and scopes rendering to the Disabled Item Action-State section.",
      "Verifies that disabled single-mode items suppress focus/invoke, roving focus skips them, and checked_state stays observable on concrete radio-button items."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 960.0, "height_px": 720.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 960.0,
        "height_px": 740.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },

    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "role": "radio_button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "state": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "disabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "action": "invoke",
        "enabled": true
      }
    },

    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "role": "radio_button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "checked": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "disabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "action": "invoke",
        "enabled": false
      }
    },

    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-gamma" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-gamma" },
        "disabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-gamma" },
        "action": "invoke",
        "enabled": true
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "state": "true"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "state": "false"
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-label" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "arrow_right" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-gamma" }
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-alpha" },
        "state": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-gamma" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-toggle-group-disabled-item-action-state-item-beta" },
        "disabled": true
      }
    },

    {
      "type": "capture_screenshot",
      "label": "ui-gallery-toggle-group-disabled-item-action-state"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-toggle-group-disabled-item-action-state",
      "max_snapshots": 1
    }
  ]
}
