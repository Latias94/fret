{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-pagination-demo-action-selected-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png",
      "diag.command_dispatch_trace"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "pagination",
      "FRET_UI_GALLERY_START_SECTION": "Demo"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "pagination",
      "link",
      "selected",
      "action_state",
      "mechanism_harness",
      "runtime"
    ],
    "target_hints": [
      "Starts directly on the Pagination Demo section.",
      "Proves PaginationLink selected semantics and invoke action exposure on numbered links.",
      "Proves Previous/Next remain link-like action endpoints and page clicks dispatch through /shell/last_action."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo" },
      "delta_y": -220.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 12.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo" },
        "role": "region"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-previous" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-1" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-3" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-next" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-1" },
        "selected": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
        "selected": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-3" },
        "selected": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-previous" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-1" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-next" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-1" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 360
    },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_test_id": "ui-gallery-pagination-demo-page-1",
        "handled": true,
        "handled_by_driver": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "cmd.open"
      },
      "timeout_frames": 360
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 360
    },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.save",
        "source_test_id": "ui-gallery-pagination-demo-page-2",
        "handled": true,
        "handled_by_driver": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "cmd.save"
      },
      "timeout_frames": 360
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-gallery-pagination-demo-page-2" },
        "selected": true
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-pagination-demo-action-selected-state.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-pagination-demo-action-selected-state"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-pagination-demo-action-selected-state"
    }
  ]
}
