{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery: card retained memory analysis (no meeting notes, preview only, nav none)",
    "tags": [
      "ui-gallery",
      "card",
      "memory",
      "analysis",
      "retained",
      "nav-none",
      "section",
      "meeting-notes",
      "preview-only"
    ],
    "required_capabilities": [
      "diag.script_v2"
    ],
    "env_defaults": {
      "FRET_DIAG_DEBUG_SNAPSHOT": 1,
      "FRET_DIAG_SEMANTICS_TEST_IDS_ONLY": 0,
      "FRET_DIAG_BUNDLE_DUMP_SEMANTICS_TEST_IDS_ONLY": 1,
      "FRET_DIAG_MAX_SEMANTICS_NODES": 8000,
      "FRET_DIAG_WGPU_ALLOCATOR_REPORT": 1,
      "FRET_DIAG_WGPU_ALLOCATOR_REPORT_EVERY_N_FRAMES": 600,
      "FRET_UI_GALLERY_START_PAGE": "card",
      "FRET_UI_GALLERY_NAV_QUERY": "__none__",
      "FRET_UI_GALLERY_BISECT": 135168
    },
    "target_hints": [
      "Starts UI Gallery on the card page with the Meeting Notes section hidden, all remaining card code tabs suppressed, and the nav list hidden so the Meeting Notes section's retained contribution can be derived from preview-only analysis runs."
    ]
  },
  "steps": [
    {
      "type": "reset_diagnostics"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-card"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/selected_page",
        "value": "card"
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/nav_visible_items_count",
        "value": 0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/bisect_flags",
        "value": 135168
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_code_tabs_disabled",
        "value": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_page_intro_disabled",
        "value": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_sections_hidden_count",
        "value": 1
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_section_slots_total",
        "value": 12
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_count",
        "value": 11
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_with_code_count",
        "value": 0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_with_shell_count",
        "value": 1
      }
    },
    {
      "type": "wait_frames",
      "n": 5
    },
    {
      "type": "reset_diagnostics"
    },
    {
      "type": "wait_frames",
      "n": 5
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-card-no-meeting-notes-preview-only-memory-retained-analysis",
      "max_snapshots": 1
    }
  ]
}
