{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery: card retained memory analysis (nav none)",
    "tags": [
      "ui-gallery",
      "card",
      "memory",
      "analysis",
      "retained",
      "nav-none"
    ],
    "required_capabilities": [
      "diag.script_v2"
    ],
    "env_defaults": {
      "FRET_DIAG_DEBUG_SNAPSHOT": 1,
      "FRET_DIAG_SEMANTICS_TEST_IDS_ONLY": 0,
      "FRET_DIAG_BUNDLE_DUMP_SEMANTICS_TEST_IDS_ONLY": 1,
      "FRET_DIAG_MAX_SEMANTICS_NODES": 8000,
      "FRET_DIAG_WGPU_ALLOCATOR_REPORT": 1,
      "FRET_DIAG_WGPU_ALLOCATOR_REPORT_EVERY_N_FRAMES": 600,
      "FRET_UI_GALLERY_START_PAGE": "card",
      "FRET_UI_GALLERY_NAV_QUERY": "__none__"
    },
    "target_hints": [
      "Starts UI Gallery on the card page with the nav list hidden, enables retained/debug snapshots, and captures a steady-state bundle for runtime-state attribution."
    ]
  },
  "steps": [
    {
      "type": "reset_diagnostics"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-card"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/selected_page",
        "value": "card"
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/nav_visible_items_count",
        "value": 0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/bisect_flags",
        "value": 0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_code_tabs_disabled",
        "value": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_page_intro_disabled",
        "value": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_sections_hidden_count",
        "value": 0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_section_slots_total",
        "value": 12
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_count",
        "value": 12
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_with_code_count",
        "value": 10
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/card_doc_visible_sections_with_shell_count",
        "value": 1
      }
    },
    {
      "type": "wait_frames",
      "n": 5
    },
    {
      "type": "reset_diagnostics"
    },
    {
      "type": "wait_frames",
      "n": 5
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-card-memory-retained-analysis",
      "max_snapshots": 1
    }
  ]
}
