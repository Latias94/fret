{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: RadioGroup required disabled action-state",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "radio_group",
      "FRET_UI_GALLERY_START_SECTION": "Required Disabled"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "radio_group",
      "form",
      "required",
      "disabled",
      "semantics",
      "action-state"
    ],
    "target_hints": [
      "Starts directly on the Radio Group page and scopes rendering to the Required Disabled section.",
      "Verifies that group-level required semantics stay on the RadioGroup root while disabled item semantics and action suppression stay on the concrete radio item and its label bridge."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 960.0, "height_px": 720.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 960.0,
        "height_px": 740.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },

    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Support plan" },
        "role": "radio_group"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Support plan" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Support plan" },
        "disabled": false
      }
    },

    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "role": "radio_button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "checked": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "disabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "action": "invoke",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "state": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "disabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "action": "invoke",
        "enabled": true
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "state": "false"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "state": "true"
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0-label" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "state": "false"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "state": "true"
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-2-label" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-2" },
        "state": "true"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-1" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-0" },
        "state": "false"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-2" },
        "disabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-radio-group-required-disabled-item-2" },
        "action": "invoke",
        "enabled": true
      }
    },

    {
      "type": "capture_screenshot",
      "label": "ui-gallery-radio-group-required-disabled-action-state"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-radio-group-required-disabled-action-state",
      "max_snapshots": 1
    }
  ]
}
