{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-sheet-demo-relation-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "sheet",
      "overlay",
      "focus",
      "relation",
      "action_state",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "sheet"
    },
    "target_hints": [
      "Proves the Sheet Demo trigger keeps fresh action and relation semantics through open and close.",
      "Asserts the trigger controls edge resolves to the sheet panel while open and clears after close.",
      "Asserts the modal barrier is active while open so ordinary underlay selectors stay inert.",
      "Asserts the dialog content exports labelled_by and described_by edges to the stable title and description nodes."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-sheet" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
      "delta_y": -220.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "relation": "controls"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" },
        "role": "dialog"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "barrier_roots",
        "barrier_root": "some",
        "focus_barrier_root": "some",
        "require_equal": true
      },
      "timeout_frames": 120
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-dialog-title" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" },
        "relation": "described_by",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-dialog-description" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focused_descendant_is",
        "scope": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" },
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-name-input" }
      },
      "timeout_frames": 120
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-name-input" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-save" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-close" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-sheet-demo-open.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-sheet-demo-open"
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-close" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo-panel" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "barrier_roots",
        "barrier_root": "none",
        "focus_barrier_root": "none"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" }
      },
      "timeout_frames": 120
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "expanded": false
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": { "kind": "test_id", "id": "ui-gallery-sheet-demo" },
        "relation": "controls"
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-sheet-demo-relation-action-state"
    }
  ]
}
