{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-alert-dialog-destructive-inline-link-activate",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "alert_dialog",
      "overlay",
      "links",
      "inline_link",
      "selectable_text",
      "action_state",
      "semantic_link",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "alert_dialog",
      "FRET_UI_GALLERY_START_SECTION": "Destructive"
    },
    "target_hints": [
      "Starts directly on Alert Dialog / Destructive.",
      "Proves the destructive description selectable text exports inline link metadata.",
      "Activates the Settings inline link while diagnostics mode suppresses external URL opening."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-alert-dialog" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-docsec-content"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-alert-dialog-destructive-trigger" },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-alert-dialog-destructive-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-alert-dialog-destructive-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-content"
        },
        "role": "alert_dialog"
      }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-description-link"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-description-link"
        },
        "role": "text"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_contains",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-description-link"
        },
        "text": "View Settings"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-description-link"
        },
        "action": "set_text_selection",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_inline_span_includes",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-alert-dialog-destructive-description-link"
        },
        "role": "link",
        "tag": "https://example.com/settings"
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-alert-dialog-destructive-inline-link-activate.before-layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-alert-dialog-destructive-inline-link-activate.before",
      "timeout_frames": 240
    },
    {
      "type": "click_selectable_text_span_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-alert-dialog-destructive-description-link"
      },
      "tag": "https://example.com/settings",
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-alert-dialog-destructive-inline-link-activate.after",
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-alert-dialog-destructive-inline-link-activate"
    }
  ]
}
