{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-context-menu-occlusion-wheel-pass-through",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"]
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll" }
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-overlay" },
      "delta_y": -720.0,
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-overlay" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" }
      },
      "timeout_frames": 240
    },

    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 4 },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "set_window_inner_size", "width_px": 1100.0, "height_px": 560.0 },
    { "type": "wait_frames", "n": 2 },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" } },
    { "type": "wait_frames", "n": 10 },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    { "type": "click", "button": "right", "target": { "kind": "test_id", "id": "ui-gallery-context-trigger" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-item-action" }
      },
      "timeout_frames": 180
    },

    { "type": "reset_diagnostics" },

    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_is_finite",
        "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y_max"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_not_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y_max",
        "value": 0.0,
        "eps": 0.01
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y",
        "value": 0.0,
        "eps": 0.01
      }
    },
    { "type": "capture_screenshot", "label": "ui-gallery-context-menu-occlusion-wheel-pass-through-before" },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-overlay-reset" }, "delta_y": -720.0 },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_not_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y",
        "value": 0.0,
        "eps": 0.01
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-content" }
      }
    },
    { "type": "capture_screenshot", "label": "ui-gallery-context-menu-occlusion-wheel-pass-through-after" },

    { "type": "capture_bundle", "label": "ui-gallery-context-menu-occlusion-wheel-pass-through" }
  ]
}
