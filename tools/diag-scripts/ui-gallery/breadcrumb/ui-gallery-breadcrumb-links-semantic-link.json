{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-breadcrumb-links-semantic-link",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png",
      "diag.command_dispatch_trace"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "breadcrumb",
      "FRET_UI_GALLERY_START_SECTION": "Dropdown"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "breadcrumb",
      "link",
      "semantics",
      "action_state",
      "command_dispatch",
      "mechanism_harness",
      "runtime"
    ],
    "target_hints": [
      "Starts directly on the Breadcrumb Dropdown section.",
      "Proves the raw-primitives BreadcrumbLink Home row exports link role, label, URL value, focus action, and invoke action.",
      "Activates the Home link through keyboard and pointer while the gallery driver records deterministic command dispatch."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-breadcrumb" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown" },
        "role": "region"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "text": "Home"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "text": "/"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-trigger" },
        "role": "button"
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-breadcrumb-links-semantic-link.before-layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-breadcrumb-links-semantic-link.before",
      "timeout_frames": 240
    },
    {
      "type": "focus",
      "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "enter" },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_kind": "keyboard",
        "handled": true,
        "handled_by_driver": true,
        "started_from_focus": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "app_snapshot_field_equals",
        "pointer": "/shell/last_action",
        "value": "cmd.open"
      },
      "timeout_frames": 360
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-breadcrumb-dropdown-home-link" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "ui_gallery.app.open",
        "source_kind": "pointer",
        "source_test_id": "ui-gallery-breadcrumb-dropdown-home-link",
        "handled": true,
        "handled_by_driver": true
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-breadcrumb-links-semantic-link.after",
      "timeout_frames": 240
    },
    { "type": "capture_bundle", "label": "ui-gallery-breadcrumb-links-semantic-link" }
  ]
}
