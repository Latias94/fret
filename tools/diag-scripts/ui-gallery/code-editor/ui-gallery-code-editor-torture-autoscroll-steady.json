{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-dev"],
    "name": "ui-gallery-code-editor-torture-autoscroll-steady",
    "required_capabilities": ["diag.script_v2"],
    "target_hints": [
      "This steady script waits for font stabilization; keep font bootstrap enabled when launching it standalone.",
      "This is a non-accessibility CPU/renderer steady-scroll baseline. Keep platform accessibility disabled here; use a dedicated a11y perf probe when measuring AccessKit activation cost."
    ],
    "env_defaults": {
      "FRET_A11Y_DISABLE": "1",
      "FRET_UI_GALLERY_BOOTSTRAP_FONTS": "1",
      "FRET_UI_GALLERY_CODE_EDITOR_TORTURE_OVERLAY": "0"
    }
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "type_text_into",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "text": "code_editor_torture",
      "clear_before_type": true,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 5 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-code-editor-torture" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-code-editor-torture" },
      "delta_y": 120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 8.0,
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-code-editor-torture" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-code-editor-torture-root" }
      },
      "timeout_frames": 600
    },
    { "type": "type_text_into", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }, "text": "", "clear_before_type": true, "timeout_frames": 600 },
    { "type": "wait_frames", "n": 90 },
    {
      "type": "wait_until",
      "predicate": { "kind": "font_catalog_populated" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "system_font_rescan_idle" },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "text_font_stack_key_stable", "stable_frames": 120 },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "reset_diagnostics" },

    { "type": "wait_frames", "n": 240 },
    { "type": "capture_bundle", "label": "ui-gallery-code-editor-torture-autoscroll-steady" },

    { "type": "wait_frames", "n": 2 },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 }
  ]
}
