{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-typography-interactive-links-activation",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "typography",
      "inline_link",
      "selectable_text",
      "interactive_spans",
      "action_state",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "typography",
      "FRET_UI_GALLERY_START_SECTION": "Interactive Links"
    },
    "target_hints": [
      "Starts directly on Typography / Interactive Links.",
      "Proves p_rich(...).inline_link(...) exports inline link span metadata on the paragraph node.",
      "Activates the selectable text span and verifies the app-owned on_activate_link state update."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-typography" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "docsec-interactive-links-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-typography-interactive-links" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-typography-interactive-links-paragraph"
      },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-paragraph"
        },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-paragraph"
        },
        "role": "text"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_contains",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-paragraph"
        },
        "text": "a brilliant plan"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-paragraph"
        },
        "action": "set_text_selection",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_inline_span_includes",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-paragraph"
        },
        "role": "link",
        "tag": "https://example.com/kings-plan"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-status-idle"
        }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-status-active"
        }
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-typography-interactive-links-activation.before-layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-typography-interactive-links-activation.before",
      "timeout_frames": 240
    },
    {
      "type": "click_selectable_text_span_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-typography-interactive-links-paragraph"
      },
      "tag": "https://example.com/kings-plan",
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-status-active"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-typography-interactive-links-status-idle"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-typography-interactive-links-activation.after",
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-typography-interactive-links-activation"
    }
  ]
}
