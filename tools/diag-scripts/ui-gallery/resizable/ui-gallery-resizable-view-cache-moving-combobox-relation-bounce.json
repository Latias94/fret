{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-resizable-view-cache-moving-combobox-relation-bounce",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png",
      "diag.overlay_placement_trace"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "resizable",
      "FRET_UI_GALLERY_START_SECTION": "ui-gallery-resizable-view-cache-moving-combobox-docsec",
      "FRET_UI_GALLERY_RESIZABLE_MOVING_CACHED_COMBOBOX": "1",
      "FRET_UI_GALLERY_VIEW_CACHE": "1"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "resizable",
      "combobox",
      "view_cache",
      "overlay",
      "root_boundary",
      "semantics",
      "relation"
    ],
    "target_hints": [
      "Starts directly on the diagnostics-only Resizable Moving Cached Combobox fixture.",
      "Opens the cached Combobox in the left root, proves input/listbox relation edges, closes it, then moves the same cached source to the right root and proves the overlay endpoints are gone while the closed trigger has no controls edge.",
      "Reopens after the cross-root move and proves controls/labelled_by resolve to the freshly mounted right-root listbox rather than a stale left-root node."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 980.0, "height_px": 980.0 },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-resizable" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-docsec-content"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-source-root-state"
        },
        "text": "left"
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
      },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_overlapping",
        "a": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "b": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-left-panel"
        },
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "relation": "controls"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "expanded": false
      }
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
      },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        },
        "relation": "controls",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        },
        "relation": "labelled_by",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "press_key",
      "key": "escape"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "relation": "controls"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "expanded": false
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-resizable-view-cache-moving-combobox-move-source"
      },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 6 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-source-root-state"
        },
        "text": "right"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_overlapping",
        "a": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "b": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-right-panel"
        },
        "eps_px": 0.5
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
        },
        "relation": "controls"
      }
    },
    { "type": "reset_diagnostics" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-resizable-view-cache-moving-combobox-trigger"
      },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "anchored_panel",
        "anchor_test_id": "ui-gallery-resizable-view-cache-moving-combobox-trigger",
        "content_test_id": "ui-gallery-resizable-view-cache-moving-combobox-content",
        "preferred_side": "bottom",
        "chosen_side": "top",
        "flipped": true,
        "side_offset_px": 6.0,
        "side_offset_eps_px": 0.25
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        },
        "relation": "controls",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-listbox"
        },
        "relation": "labelled_by",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-resizable-view-cache-moving-combobox-input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-resizable-view-cache-moving-combobox-relation-bounce.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-resizable-view-cache-moving-combobox-relation-bounce"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-resizable-view-cache-moving-combobox-relation-bounce"
    }
  ]
}
