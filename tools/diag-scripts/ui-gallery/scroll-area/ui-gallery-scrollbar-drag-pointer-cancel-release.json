{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-scrollbar-drag-pointer-cancel-release",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["scroll", "scrollbar", "pointer_cancel", "ui_gallery", "regression_pack"]
  },
  "steps": [
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "scroll area" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll-area" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll-area" },
      "delta_y": -240.0,
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll-area" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-scroll-area" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-scroll-area-drag-baseline-arm-grow"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-scroll-area-drag-baseline-arm-grow"
      },
      "delta_y": -240.0,
      "timeout_frames": 600,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 4.0
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-drag-baseline-arm-grow" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-drag-baseline-armed" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-scroll-area-drag-baseline-y-scrollbar"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-scroll-area-drag-baseline-y-scrollbar"
      },
      "delta_y": -240.0,
      "timeout_frames": 600,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 4.0
    },
    {
      "type": "pointer_down",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-scroll-area-drag-baseline-y-scrollbar"
      },
      "button": "left"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "input_pointer_capture_active_is",
        "active": true
      },
      "timeout_frames": 120
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "captured_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-scroll-area-drag-baseline-y-scrollbar"
        },
        "captured": true
      },
      "timeout_frames": 120
    },
    { "type": "pointer_cancel" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "input_pointer_capture_active_is",
        "active": false
      },
      "timeout_frames": 120
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "captured_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-scroll-area-drag-baseline-y-scrollbar"
        },
        "captured": false
      },
      "timeout_frames": 120
    },
    { "type": "capture_bundle", "label": "scrollbar-drag-pointer-cancel-release" }
  ]
}
