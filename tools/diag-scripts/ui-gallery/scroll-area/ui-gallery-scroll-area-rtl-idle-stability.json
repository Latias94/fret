{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-scroll-area-rtl-idle-stability",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": [
      "ui_gallery",
      "shadcn",
      "scroll_area",
      "scroll",
      "rtl",
      "idle_stability",
      "mechanism_harness"
    ],
    "target_hints": [
      "Scrolls the Scroll Area docs page to the RTL ScrollArea, then scrolls the nested RTL viewport.",
      "The idle-stability assertions fail if either the outer content viewport or the nested RTL ScrollArea keeps drifting after scripted input stops."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "scroll area" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll-area" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 300
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll-area" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-scroll-area" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "motion_check": {
        "scroll_target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y",
        "max_target_reverse_px": 1.0,
        "max_scroll_reverse_px": 1.0,
        "require_scroll_progress": true
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_semantics_scroll_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "stable_frames": 8,
      "max_delta": 0.25,
      "timeout_frames": 300
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 300
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_is_finite",
        "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
        "field": "y_max"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_scroll_not_approx_eq",
        "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
        "field": "y_max",
        "value": 0.0,
        "eps": 0.01
      }
    },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "delta_y": -240.0
    },
    {
      "type": "wheel",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "delta_y": -240.0
    },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "wait_semantics_scroll_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "field": "y",
      "stable_frames": 8,
      "max_delta": 0.25,
      "timeout_frames": 300
    },
    {
      "type": "assert_semantics_scroll_idle_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-scroll-area-rtl-viewport" },
      "field": "y",
      "frames": 60,
      "max_delta": 0.25,
      "max_total_delta": 0.5
    },
    {
      "type": "assert_semantics_scroll_idle_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "frames": 60,
      "max_delta": 0.25,
      "max_total_delta": 0.5
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-scroll-area-rtl-idle-stability"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-scroll-area-rtl-idle-stability"
    }
  ]
}
