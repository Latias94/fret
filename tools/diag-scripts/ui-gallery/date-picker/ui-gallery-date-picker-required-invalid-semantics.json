{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Date Picker required and invalid semantics",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "date_picker",
      "FRET_UI_GALLERY_START_SECTION": "Compact Builder (Fret),Invalid",
      "FRET_UI_GALLERY_FIXED_TODAY": "2026-05-21"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "date-picker",
      "semantics",
      "required",
      "invalid",
      "form-state"
    ],
    "target_hints": [
      "Starts directly on the Date Picker page and scopes rendering to the Compact Builder and Invalid sections.",
      "Verifies that required and invalid form-state semantics live on the DatePicker trigger button rather than only on Field chrome."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1120.0,
        "height_px": 780.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "role": "button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "invalid": null
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-compact-builder-trigger" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-date-picker-required-trigger-semantics"
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "role": "button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "invalid": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-error" }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-label" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-date-picker-invalid-trigger-semantics"
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-date-picker-invalid-calendar" }
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-date-picker-invalid-popover"
    },
    { "type": "capture_bundle", "label": "ui-gallery-date-picker-required-invalid-semantics" }
  ]
}
