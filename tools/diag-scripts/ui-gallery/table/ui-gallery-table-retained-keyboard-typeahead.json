        "kind": "exists",
        "target": {
          "id": "ui-gallery-table-retained-row-0",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "target": {
        "id": "ui-gallery-table-retained-row-0",
        "kind": "test_id"
      },
      "type": "move_pointer"
    },
    {
      "button": "left",
      "target": {
        "id": "ui-gallery-table-retained-row-0",
        "kind": "test_id"
      },
      "type": "click"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
