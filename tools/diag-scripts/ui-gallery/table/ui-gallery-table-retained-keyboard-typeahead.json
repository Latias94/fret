        "eps_px": 0.0,
        "kind": "bounds_within_window",
        "padding_px": 2.0,
        "target": {
          "id": "ui-gallery-table-retained-row-9000",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "label": "ui-gallery-table-retained-keyboard-typeahead",
      "type": "capture_bundle"
    }
  ]
