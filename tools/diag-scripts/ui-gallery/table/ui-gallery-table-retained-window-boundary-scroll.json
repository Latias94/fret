{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-dev"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "table_retained_torture"
    }
  },
  "steps": [
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-table-retained-torture-root",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-table-retained-row-0",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "target": {
        "id": "ui-gallery-table-retained-row-0",
        "kind": "test_id"
      },
      "type": "move_pointer"
    },
    {
      "delta_x": 0.0,
      "delta_y": -720.0,
      "pointer_kind": "touch",
      "target": {
        "id": "ui-gallery-table-retained-torture-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 2,
      "type": "wait_frames"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-table-retained-row-25",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "predicate": {
        "kind": "not_exists",
        "target": {
          "id": "ui-gallery-table-retained-row-0",
          "kind": "test_id"
        }
      },
      "type": "assert"
    },
    {
      "predicate": {
        "attached_items_min": 1,
        "detached_items_min": 1,
        "kind": "retained_virtual_list_reconciles_matching_ge",
        "min": 1,
        "reconcile_kind": "escape"
      },
      "type": "assert"
    },
    {
      "delta_x": 0.0,
      "delta_y": 720.0,
      "pointer_kind": "touch",
      "target": {
        "id": "ui-gallery-table-retained-torture-root",
        "kind": "test_id"
      },
      "type": "wheel"
    },
    {
      "n": 5,
      "type": "wait_frames"
    },
    {
      "predicate": {
        "kind": "exists",
        "target": {
          "id": "ui-gallery-table-retained-row-0",
          "kind": "test_id"
        }
      },
      "timeout_frames": 240,
      "type": "wait_until"
    },
    {
      "label": "ui-gallery-table-retained-window-boundary-scroll",
      "type": "capture_bundle"
    }
  ]
}
