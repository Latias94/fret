{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-table-rtl-idle-stability",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": [
      "ui_gallery",
      "shadcn",
      "table",
      "scroll",
      "rtl",
      "idle_stability",
      "mechanism_harness"
    ],
    "target_hints": [
      "Scrolls the Table docs page to the RTL section and samples the outer Gallery content viewport with no scripted input.",
      "This covers the table/RTL companion to the Checkbox and ScrollArea idle-stability gates."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-scroll" }
      },
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_shortcut", "shortcut": "primary+a" },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "table" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-table" },
        "padding_px": 8.0
      },
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-table" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-rtl-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-rtl-row-inv007" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-table-rtl-title" },
      "delta_y": -180.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "padding_insets_px": {
        "left_px": 16.0,
        "top_px": 16.0,
        "right_px": 16.0,
        "bottom_px": 40.0
      },
      "motion_check": {
        "scroll_target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y",
        "max_target_reverse_px": 1.0,
        "max_scroll_reverse_px": 1.0,
        "require_scroll_progress": true
      },
      "timeout_frames": 1800
    },
    {
      "type": "wait_semantics_scroll_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "stable_frames": 8,
      "max_delta": 0.25,
      "timeout_frames": 300
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-table-rtl-title" },
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 300
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-table-rtl-row-inv007" },
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 300
    },
    {
      "type": "assert_semantics_scroll_idle_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "frames": 60,
      "max_delta": 0.25,
      "max_total_delta": 0.5
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-table-rtl-idle-stability"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-table-rtl-idle-stability"
    }
  ]
}
