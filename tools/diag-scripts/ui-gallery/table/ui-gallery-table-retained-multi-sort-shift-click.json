{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-dev"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "table_retained_torture"
    }
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-retained-torture-root" }
      },
      "timeout_frames": 240
    },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-retained-header-row" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "padding_px": 2.0,
        "target": { "kind": "test_id", "id": "ui-gallery-table-retained-header-row" }
      },
      "timeout_frames": 240
    },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-table-retained-header-status" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-table-retained-header-status" } },
    { "type": "wait_frames", "n": 2 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "role_and_name", "role": "text", "name": "Sorting: status asc" }
      },
      "timeout_frames": 240
    },

    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-table-retained-header-mem_mb" },
      "modifiers": { "shift": true }
    },
    { "type": "wait_frames", "n": 2 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "role_and_name",
          "role": "text",
          "name": "Sorting: status asc, mem_mb asc"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "role_and_name",
          "role": "text",
          "name": "mem_mb ▲2"
        }
      }
    },

    { "type": "capture_bundle", "label": "ui-gallery-table-retained-multi-sort-shift-click" }
  ]
}
