{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-accordion-usage-toggle",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["ui_gallery", "shadcn", "accordion", "usage", "interaction", "semantics", "a11y"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "accordion"
    },
    "target_hints": [
      "Proves the Accordion Usage trigger mutates its expanded semantics state when toggled.",
      "Also keeps the existing panel mount/unmount behavior gate for the collapsible single item."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-accordion" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
      "delta_y": -220.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-panel" }
      },
      "timeout_frames": 120
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
        "expanded": true
      }
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
      "stable_frames": 4,
      "max_move_px": 0.75,
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
      "stable_frames": 4,
      "max_move_px": 0.75,
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-panel" }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
        "expanded": false
      }
    },
    { "type": "capture_bundle", "label": "ui-gallery-accordion-usage-toggle-closed" },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
      "stable_frames": 4,
      "max_move_px": 0.75,
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-panel" }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-usage-trigger" },
        "expanded": true
      }
    },
    { "type": "capture_bundle", "label": "ui-gallery-accordion-usage-toggle-open" }
  ]
}
