{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-accordion-demo-relation-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "required_launch_features": ["gallery-dev"],
    "tags": [
      "ui_gallery",
      "shadcn",
      "accordion",
      "relation",
      "action_state",
      "expanded",
      "keyboard",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "accordion"
    },
    "target_hints": [
      "Proves Accordion Demo trigger controls and content labelled_by relations migrate between open items.",
      "Asserts trigger expanded/invoke action state and content role=region through pointer and keyboard activation.",
      "Asserts collapsible close clears the relation endpoint when the panel unmounts."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-accordion" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo" },
      "delta_y": -220.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "role": "button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "role": "button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "expanded": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" },
        "role": "region"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-accordion-demo-shipping-open.layout"
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "expanded": false
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "expanded": true
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" },
        "role": "region"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-shipping-trigger" },
        "relation": "controls"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" }
      },
      "timeout_frames": 240
    },
    {
      "type": "focus",
      "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "enter" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "expanded": false
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-trigger" },
        "relation": "controls"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-accordion-demo-returns-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-accordion-demo-closed"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-accordion-demo-relation-action-state"
    }
  ]
}
