{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Textarea required and invalid semantics",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "textarea"
    },
    "tags": ["ui_gallery", "shadcn", "textarea", "semantics", "required", "invalid", "form-state"],
    "target_hints": [
      "Starts directly on the Textarea page.",
      "Verifies that required and invalid form-state semantics live on the concrete TextArea nodes, not just on Field chrome."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1120.0,
        "height_px": 780.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "invalid": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "required": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-invalid-control" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-textarea-invalid-semantics"
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "invalid": null
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-textarea-required-control" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-textarea-required-semantics"
    },
    { "type": "capture_bundle", "label": "ui-gallery-textarea-required-invalid-semantics" }
  ]
}
