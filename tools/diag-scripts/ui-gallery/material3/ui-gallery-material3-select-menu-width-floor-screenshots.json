{
  "schema_version": 2,
  "meta": {
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_select"
    },
    "required_launch_features": ["gallery-material3"],
    "name": "ui-gallery-material3-select-menu-width-floor-screenshots",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "material3", "select", "width_floor", "screenshots"]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-select" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped" },
      "delta_y": -240.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    { "type": "capture_screenshot", "label": "m3-select-floor-00-page" },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped" } },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped" } },
    { "type": "wait_frames", "n": 2 },
    { "type": "press_key", "key": "arrow_down" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped.listbox" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "label": "m3-select-floor-10-on-open" },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped.listbox" }
      },
      "timeout_frames": 600
    },

    { "type": "ensure_visible", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-menu-width-floor-toggle" }, "within_window": true, "padding_px": 8.0, "timeout_frames": 600 },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-menu-width-floor-toggle" } },
    { "type": "wait_frames", "n": 10 },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped.listbox" }
      },
      "timeout_frames": 600
    },
    { "type": "capture_screenshot", "label": "m3-select-floor-20-off" },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped" } },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped" } },
    { "type": "wait_frames", "n": 2 },
    { "type": "press_key", "key": "arrow_down" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-select-unclamped.listbox" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "label": "m3-select-floor-30-off-open" },

    { "type": "capture_bundle", "label": "ui-gallery-material3-select-menu-width-floor-screenshots" }
  ]
}
