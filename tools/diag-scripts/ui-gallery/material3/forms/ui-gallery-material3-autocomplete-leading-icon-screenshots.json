{
  "meta": {
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_autocomplete"
    },
    "required_launch_features": ["gallery-material3"],
    "name": "ui-gallery-material3-autocomplete-leading-icon-screenshots",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "material3", "autocomplete", "leading_icon", "screenshots"]
  },
  "schema_version": 2,
  "steps": [
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-autocomplete" }
      }
    },
    {
      "type": "click",
      "button": "left",
      "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
    },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-dark" }
      }
    },
    {
      "type": "click",
      "button": "left",
      "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-dark" }
    },
    { "type": "wait_frames", "n": 10 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-autocomplete" },
      "delta_y": -160.0,
      "require_fully_within_container": false,
      "require_fully_within_window": false,
      "padding_px": 16.0,
      "padding_insets_px": {
        "left_px": 16.0,
        "top_px": 16.0,
        "right_px": 16.0,
        "bottom_px": 40.0
      },
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-autocomplete" }
      }
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "timeout_frames": 300, "label": "ui-gallery-material3-autocomplete-leading-icon-zinc-dark" },

    { "type": "click", "button": "left", "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" } },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-light" }
      }
    },
    { "type": "click", "button": "left", "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-light" } },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "timeout_frames": 300, "label": "ui-gallery-material3-autocomplete-leading-icon-zinc-light" },

    { "type": "capture_bundle", "label": "ui-gallery-material3-autocomplete-leading-icon-screenshots" }
  ]
}
