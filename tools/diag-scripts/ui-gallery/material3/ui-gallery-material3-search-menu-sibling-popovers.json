{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-material3-search-menu-sibling-popovers",
    "required_launch_features": ["gallery-material3"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_menu"
    },
    "required_capabilities": ["diag.script_v2"],
    "tags": [
      "ui_gallery",
      "material3",
      "search_view",
      "menu",
      "dropdown_menu",
      "sibling_popover",
      "focus_restore",
      "dismiss"
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-menu" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 15 },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" },
      "delta_y": -240.0,
      "require_fully_within_window": true,
      "padding_px": 180.0,
      "timeout_frames": 600
    },
    {
      "type": "ensure_visible",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" },
      "within_window": true,
      "padding_px": 8.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" },
        "min_w_px": 240.0,
        "min_h_px": 48.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "alpha" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search" },
        "text": "alpha"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-panel" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_min_size",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-panel" },
        "min_w_px": 240.0,
        "min_h_px": 80.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-search-menu-search-open"
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions-trigger" },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-panel" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions" },
        "role": "menu"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions-alpha" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focused_descendant_is",
        "scope": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions" },
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions-alpha" }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-search-menu-actions-open"
    },

    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-menu-search-actions-trigger" }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-search-menu-sibling-popovers"
    }
  ]
}
