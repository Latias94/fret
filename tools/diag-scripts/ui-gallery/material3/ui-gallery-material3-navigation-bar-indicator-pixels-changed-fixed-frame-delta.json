{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-material3"],
    "env_defaults": { "FRET_DIAG_FIXED_FRAME_DELTA_MS": "16" },
    "name": "ui-gallery-material3-navigation-bar-indicator-pixels-changed-fixed-frame-delta",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "material3", "navigation_bar", "indicator", "fixed_frame_delta", "screenshots"]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "material3 navigation bar" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-material3-navigation-bar" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-material3-navigation-bar" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-nav-settings" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-navigation-bar.active-indicator" }
      },
      "timeout_frames": 240
    },

    { "type": "wait_frames", "n": 10 },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-navigation-bar-indicator-before"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-material3-navigation-bar-indicator-before"
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-nav-settings" }
    },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-navigation-bar-indicator-after"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-material3-navigation-bar-indicator-after"
    },

    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-navigation-bar-indicator-pixels-changed-fixed-frame-delta"
    }
  ]
}
