{
  "meta": {
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_button"
    },
    "required_launch_features": ["gallery-material3"],
    "name": "ui-gallery-material3-button-sizes-screenshots",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "material3", "button", "sizes", "screenshots"]
  },
  "schema_version": 2,
  "steps": [
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-button" }
      }
    },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      }
    },
    {
      "type": "click",
      "button": "left",
      "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
    },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-dark" }
      }
    },
    {
      "type": "click",
      "button": "left",
      "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-dark" }
    },
    { "type": "wait_frames", "n": 10 },

    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-button-size-filled-xsmall" }
      }
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "timeout_frames": 300, "label": "ui-gallery-material3-button-sizes-zinc-dark" },

    { "type": "click", "button": "left", "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" } },
    {
      "type": "wait_until",
      "timeout_frames": 600,
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-light" }
      }
    },
    { "type": "click", "button": "left", "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-item-zinc-light" } },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_screenshot", "timeout_frames": 300, "label": "ui-gallery-material3-button-sizes-zinc-light" },

    { "type": "capture_bundle", "label": "ui-gallery-material3-button-sizes-screenshots" }
  ]
}
