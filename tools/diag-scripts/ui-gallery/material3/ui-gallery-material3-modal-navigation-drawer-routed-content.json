{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-material3-modal-navigation-drawer-routed-content",
    "required_launch_features": ["gallery-material3"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_modal_navigation_drawer"
    },
    "required_capabilities": ["diag.script_v2"],
    "tags": [
      "ui_gallery",
      "material3",
      "modal_navigation_drawer",
      "routed_content",
      "close_on_select",
      "focus_restore"
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-page-material3-modal-navigation-drawer"
        }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 15 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-modal-drawer-open" },
      "delta_y": -240.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer-route-panel-search"
        }
      },
      "timeout_frames": 240
    },

    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-material3-modal-drawer-open"
      },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer.panel"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "selected": true,
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-drawer-search"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-material3-modal-drawer-settings"
      },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer-route-panel-settings"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer-route-panel-search"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer.panel"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-drawer-open"
        }
      },
      "timeout_frames": 240
    },

    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-material3-modal-drawer-open"
      },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer.panel"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "selected": true,
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-drawer-settings"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-material3-modal-drawer-play"
      },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer-route-panel-play"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer-route-panel-settings"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-navigation-drawer.panel"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-modal-drawer-open"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-modal-navigation-drawer-routed-content"
    }
  ]
}
