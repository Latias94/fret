{
  "schema_version": 2,
  "meta": {
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_state_matrix"
    },
    "required_launch_features": ["gallery-material3"],
    "name": "ui-gallery-material3-search-view-screenshots",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "material3", "search_view", "screenshots"]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-state-matrix" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-search-view" },
      "delta_y": -220.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 600
    },
    {
      "type": "ensure_visible",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-search-view" },
      "within_window": true,
      "padding_px": 8.0,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-material3-search-view" },
      "button": "left",
      "stable_frames": 4,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-search-view" }
      },
      "timeout_frames": 240
    },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-material3-search-view-panel" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 20 },

    { "type": "capture_bundle", "label": "ui-gallery-material3-search-view-open" },
    { "type": "capture_screenshot", "label": "ui-gallery-material3-search-view-open" },

    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 20 },

    { "type": "capture_bundle", "label": "ui-gallery-material3-search-view-closed" },
    { "type": "capture_screenshot", "label": "ui-gallery-material3-search-view-closed" }
  ]
}
