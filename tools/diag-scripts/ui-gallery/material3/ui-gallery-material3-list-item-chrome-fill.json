{
  "meta": {
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "material3_list"
    },
    "required_launch_features": ["gallery-material3"],
    "name": "ui-gallery-material3-list-item-chrome-fill",
    "required_capabilities": ["diag.script_v2"],
    "tags": ["ui_gallery", "material3", "list", "list_item", "visual_chrome", "diagnostics"]
  },
  "schema_version": 2,
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-material3-list" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 15 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-gallery-material3-standard-list-item-alpha" },
      "delta_y": -240.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-standard-list-item-alpha"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-standard-list-item-alpha.chrome"
        }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_min_size",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-material3-standard-list-item-alpha"
        },
        "min_w_px": 120.0,
        "min_h_px": 40.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_approx_equal",
        "a": { "kind": "test_id", "id": "ui-gallery-material3-standard-list-item-alpha" },
        "b": {
          "kind": "test_id",
          "id": "ui-gallery-material3-standard-list-item-alpha.chrome"
        },
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_approx_equal",
        "a": { "kind": "test_id", "id": "ui-gallery-material3-expressive-list-item-alpha" },
        "b": {
          "kind": "test_id",
          "id": "ui-gallery-material3-expressive-list-item-alpha.chrome"
        },
        "eps_px": 1.0
      }
    },

    {
      "type": "capture_bundle",
      "label": "ui-gallery-material3-list-item-chrome-fill"
    }
  ]
}
