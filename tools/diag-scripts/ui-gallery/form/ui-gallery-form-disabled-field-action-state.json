{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Form disabled Field action-state",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "form",
      "FRET_UI_GALLERY_START_SECTION": "Disabled Field"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "form",
      "field",
      "disabled",
      "semantics",
      "action-state"
    ],
    "target_hints": [
      "Starts directly on the Form page and scopes rendering to the Disabled Field section.",
      "Verifies that disabled Field shell state is visual/grouping policy while disabled semantics and action suppression live on the concrete Input control."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 960.0, "height_px": 720.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 960.0,
        "height_px": 740.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-group" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-group" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "disabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "action": "set_value",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "text": "Disabled profile"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "disabled_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-enabled-control" },
        "disabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-enabled-control" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-enabled-control" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-enabled-control" },
      "text": "Updated enabled profile",
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-enabled-control" },
        "text": "Updated enabled profile"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-form-disabled-field-control" },
        "text": "Disabled profile"
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-form-disabled-field-action-state"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-form-disabled-field-action-state",
      "max_snapshots": 1
    }
  ]
}
