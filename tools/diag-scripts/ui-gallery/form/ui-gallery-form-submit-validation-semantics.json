{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Form submit validation semantics",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "form",
      "FRET_UI_GALLERY_START_SECTION": "Submit Validation"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "form",
      "semantics",
      "required",
      "invalid",
      "form-state",
      "submit-validation"
    ],
    "target_hints": [
      "Starts directly on the Form page and scopes rendering to the Submit Validation section.",
      "Verifies that submit-driven FormState validation mutates required/invalid semantics on FormField-decorated controls."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1120.0,
        "height_px": 780.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "invalid": null
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Plan" },
        "role": "radio_group"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Plan" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Plan" },
        "invalid": null
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-result" },
        "text": "status=not_submitted"
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-form-submit-validation-before-submit"
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-submit" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "invalid": "true"
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Plan" },
        "invalid": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "role_and_name", "role": "alert", "name": "Username is required." }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "role_and_name", "role": "alert", "name": "Choose a plan." }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-result" },
        "text": "status=invalid"
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-form-submit-validation-after-invalid-submit"
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
      "text": "Ada Lovelace",
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-plan-item-1" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "invalid": null
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "role_and_name", "role": "radio_group", "name": "Plan" },
        "invalid": null
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-username-control" },
        "text": "Ada Lovelace"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-plan-item-1" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "role_and_name", "role": "alert", "name": "Username is required." }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "role_and_name", "role": "alert", "name": "Choose a plan." }
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-submit" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-form-submit-validation-result" },
        "text": "status=valid"
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-form-submit-validation-after-repair"
    },
    { "type": "capture_bundle", "label": "ui-gallery-form-submit-validation-semantics" }
  ]
}
