{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-checkbox-demo-with-title-toggle-underflow",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": [
      "ui_gallery",
      "shadcn",
      "checkbox",
      "field_label",
      "interaction",
      "layout_dirty",
      "regression"
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1080.0, "height_px": 700.0 },
    { "type": "wait_frames", "n": 20 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "type_text_into",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "text": "checkbox",
      "clear_before_type": true,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-checkbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-checkbox" },
      "delta_y": -240.0,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-checkbox" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-checkbox" }
      },
      "timeout_frames": 600
    },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title" },
        "checked": false
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-checkbox-demo-with-title.before"
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title-label" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title" },
        "checked": true
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title-label" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-demo-with-title" },
        "checked": false
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 4 },

    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-checkbox-demo-with-title.after"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-checkbox-demo-with-title-toggle-underflow"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-checkbox-demo-with-title-toggle-underflow"
    }
  ]
}
