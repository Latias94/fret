{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Checkbox table mixed-state action",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "checkbox"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "checkbox",
      "table",
      "semantics",
      "mixed-state",
      "action-state"
    ],
    "target_hints": [
      "Starts directly on the Checkbox page.",
      "Verifies that the table select-all checkbox exports explicit mixed/true checked-state semantics while keeping invoke enabled through row and select-all mutations."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 820.0, "height_px": 760.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-checkbox" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table" },
      "delta_y": -160.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "role": "checkbox"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "state": "mixed"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-1" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
        "checked": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-3" },
        "checked": false
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "state": "true"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-1" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-3" },
        "checked": true
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "state": "mixed"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-1" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
        "checked": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-3" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
        "action": "invoke",
        "enabled": true
      }
    },

    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
      "stable_frames": 2,
      "max_move_px": 2.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "checked_state_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-all" },
        "state": "true"
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-1" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-2" },
        "checked": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "checked_is",
        "target": { "kind": "test_id", "id": "ui-gallery-checkbox-table-row-3" },
        "checked": true
      }
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-checkbox-table-mixed-state-action",
      "max_snapshots": 1
    },
    { "type": "capture_screenshot", "label": "ui-gallery-checkbox-table-mixed-state-action" }
  ]
}
