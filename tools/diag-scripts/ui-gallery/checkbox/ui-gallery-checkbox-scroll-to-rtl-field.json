{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-checkbox-scroll-to-rtl-field",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui_gallery", "shadcn", "checkbox", "scroll", "rtl", "idle_stability", "mechanism_harness"],
    "target_hints": [
      "Scrolls the default Checkbox page to the RTL section and then samples the content viewport with no scripted input.",
      "The final idle-stability assertion fails if the viewport keeps drifting or oscillating after the RTL section is visible."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 20 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "checkbox" },
    { "type": "wait_frames", "n": 2 },

    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-checkbox" }
      },
      "timeout_frames": 600
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-checkbox" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-checkbox" }
      },
      "timeout_frames": 600
    },

    { "type": "move_pointer", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" } },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wheel", "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" }, "delta_y": -800.0 },
    { "type": "wait_frames", "n": 10 },

    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-rtl" },
      "delta_y": -200.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "motion_check": {
        "scroll_target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
        "field": "y",
        "max_target_reverse_px": 1.0,
        "max_scroll_reverse_px": 1.0,
        "require_scroll_progress": true
      },
      "timeout_frames": 900
    },
    {
      "type": "wait_semantics_scroll_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "stable_frames": 8,
      "max_delta": 0.25,
      "timeout_frames": 300
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-checkbox-rtl" },
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 300
    },
    {
      "type": "assert_semantics_scroll_idle_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "field": "y",
      "frames": 45,
      "max_delta": 0.25,
      "max_total_delta": 0.5
    },
    { "type": "capture_screenshot", "label": "ui-gallery-checkbox-scroll-to-rtl-field.rtl_visible" },
    { "type": "capture_bundle", "label": "ui-gallery-checkbox-scroll-to-rtl-field" }
  ]
}
