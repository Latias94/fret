        "role": "button",
        "name": "Pin"
      }
    },
    {
      "type": "wait_frames",
      "n": 2
    },
    {
      "type": "click",
      "target": {
        "kind": "role_and_name",
        "role": "menu_item_radio",
        "name": "Pin mem_mb right"
      }
    },
    {
      "type": "wait_frames",
      "n": 2
    },
    {
      "type": "scroll_into_view",
      "container": {
        "kind": "test_id",
        "id": "ui-gallery-data-table-torture-root"
      },
      "target": {
        "kind": "test_id",
        "id": "ui-gallery-data-table-header-name"
      },
      "delta_x": -140.0,
      "delta_y": 0.0,
      "require_fully_within_window": true,
      "padding_px": 2.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_frames",
      "n": 2
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_within_window",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-data-table-header-mem_mb"
        },
        "padding_px": 2.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_within_window",
        "target": {
          "kind": "test_id",
          "id": "ui-gallery-data-table-row-0-cell-mem_mb"
        },
        "padding_px": 2.0,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "bounds_overlapping_x",
        "a": {
          "kind": "test_id",
          "id": "ui-gallery-data-table-header-mem_mb"
        },
        "b": {
          "kind": "test_id",
          "id": "ui-gallery-data-table-row-0-cell-mem_mb"
        },
        "eps_px": 1.0
      }
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-data-table-retained-column-pinning-sticky-scroll"
    }
  ]
