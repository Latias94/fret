{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-context-menu-submenu-safe-corridor-sweep",
    "required_capabilities": ["diag.script_v2", "diag.overlay_placement_trace"]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },

    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "context menu" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-context-menu" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-context-menu" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-context-menu" }
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-trigger" },
      "delta_y": -360.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 1200
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-trigger" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },

    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-trigger" }
    },
    {
      "type": "click_stable",
      "button": "right",
      "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-trigger" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-content" }
      },
      "timeout_frames": 240
    },

    {
      "type": "move_pointer",
      "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-more-tools" }
    },
    { "type": "wait_frames", "n": 12 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-save-page" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_overlay_placement_trace",
      "query": {
        "kind": "placed_rect",
        "anchor_test_id": "ui-gallery-context-menu-submenu-more-tools",
        "chosen_side": "right"
      },
      "timeout_frames": 240
    },

    {
      "type": "move_pointer_sweep",
      "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-more-tools" },
      "delta_x": 12.0,
      "delta_y": 1.5,
      "steps": 16,
      "frames_per_step": 1
    },
    { "type": "wait_frames", "n": 4 },
    {
      "type": "assert",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-context-menu-submenu-save-page" }
      }
    },

    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-context-menu-submenu-safe-corridor-sweep.layout"
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-context-menu-submenu-safe-corridor-sweep"
    }
  ]
}
