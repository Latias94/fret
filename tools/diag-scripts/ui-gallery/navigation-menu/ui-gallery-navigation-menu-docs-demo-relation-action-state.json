{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-navigation-menu-docs-demo-relation-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "navigation_menu",
      "overlay",
      "focus",
      "relation",
      "action_state",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "navigation_menu"
    },
    "target_hints": [
      "Proves the NavigationMenu docs demo trigger exports fresh expanded and invoke semantics.",
      "Asserts the trigger controls edge resolves to the active viewport content wrapper while open.",
      "Asserts contentless top-level links stay link-like and do not expose dangling controls edges.",
      "Asserts entry-key focus can enter the controlled content before Escape closes the viewport."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-navigation-menu" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo" },
      "delta_y": -240.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 12.0,
      "timeout_frames": 1200
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "role": "button"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-content-components" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-docs" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-docs" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_is_empty",
        "source": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-docs" },
        "relation": "controls"
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-viewport" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-content-components" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "expanded": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-content-components" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-link-alert-dialog" },
        "role": "link"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-link-alert-dialog" },
        "action": "invoke",
        "enabled": true
      }
    },
    { "type": "press_key", "key": "arrow_down" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-link-alert-dialog" }
      },
      "timeout_frames": 600
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-navigation-menu-docs-demo-open.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-navigation-menu-docs-demo-open-relation-action-state"
    },
    { "type": "press_key", "key": "escape" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-viewport" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-content-components" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-gallery-navigation-menu-docs-demo-trigger-components" },
        "expanded": false
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_bundle",
      "label": "ui-gallery-navigation-menu-docs-demo-relation-action-state"
    }
  ]
}
