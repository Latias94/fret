{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-button-group-text-label-control-action-state",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": [
      "ui_gallery",
      "shadcn",
      "button_group",
      "button_group_text",
      "label",
      "relation",
      "action_state",
      "text_input",
      "mechanism_harness",
      "runtime"
    ],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "button_group",
      "FRET_UI_GALLERY_START_SECTION": "ButtonGroupText"
    },
    "target_hints": [
      "Proves ButtonGroupText can host an explicit Label::for_control(...) child without stealing text-field semantics.",
      "Asserts the label controls edge resolves to the input and the input labelled_by edge resolves back to the label.",
      "Clicks the prefix label, proves focus routes to the input, and verifies the input remains writable."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-button-group" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-content" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
      "delta_y": -120.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "padding_px": 2.0,
        "eps_px": 1.0
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text" },
        "role": "group"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix" },
        "role": "group"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "role": "text"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "text": "https://"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "action": "set_value",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
        "relation": "controls",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_relation_includes",
        "source": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" },
        "relation": "labelled_by",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" }
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-suffix" },
        "role": "group"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-suffix.label" },
        "role": "text"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-suffix.label" },
        "action": "focus",
        "enabled": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-suffix.label" },
        "action": "set_value",
        "enabled": false
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-prefix-label" },
      "stable_frames": 3,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "docs" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-button-group-text-control" },
        "text": "docs"
      },
      "timeout_frames": 240
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-button-group-text-label-control-action-state.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-button-group-text-label-control-action-state"
    },
    { "type": "capture_bundle", "label": "ui-gallery-button-group-text-label-control-action-state" }
  ]
}
