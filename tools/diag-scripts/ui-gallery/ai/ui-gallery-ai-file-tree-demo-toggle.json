{
  "schema_version": 2,
  "meta": {
    "required_launch_features": ["gallery-dev"]
  },
  "steps": [
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 240
    },
    { "type": "click", "target": { "kind": "test_id", "id": "ui-gallery-nav-search" } },
    { "type": "press_key", "key": "a", "modifiers": { "ctrl": true } },
    { "type": "press_key", "key": "backspace" },
    { "type": "type_text", "text": "ai file tree" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-ai-file-tree-demo" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-ai-file-tree-demo" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-root" }
      },
      "timeout_frames": 240
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-viewport" },
      "target": { "kind": "test_id", "id": "ui-ai-file-tree-root" },
      "delta_y": -240.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 1800
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" }
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-root" },
        "role": "list"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "role": "tree_item"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "level_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "level": 1
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "expanded": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "selected": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" }
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "expanded_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "expanded": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "selected": true
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" },
        "role": "tree_item"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "level_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" },
        "level": 2
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" },
        "selected": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" },
        "action": "invoke",
        "enabled": true
      }
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "raw_semantics_hidden_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-selected-marker" },
        "hidden": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-file-lib" },
        "selected": true
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-ai-file-tree-folder-src" },
        "selected": false
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 10 },
    { "type": "capture_bundle", "label": "ui-gallery-ai-file-tree-demo-toggle" }
  ]
}
