{
  "schema_version": 2,
  "meta": {
    "name": "UI gallery: Input OTP invalid and required semantics",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "input_otp",
      "FRET_UI_GALLERY_START_SECTION": "Invalid,Form"
    },
    "tags": [
      "ui_gallery",
      "shadcn",
      "input-otp",
      "semantics",
      "required",
      "invalid",
      "form-state"
    ],
    "target_hints": [
      "Starts directly on the Input OTP page.",
      "Verifies that slot-level invalid chrome promotes invalid semantics to the hidden root OTP TextInput.",
      "Verifies that required form-state semantics remain on the hidden root OTP TextInput in the verification form example."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1120.0, "height_px": 760.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "window_inner_size_approx_equal",
        "width_px": 1120.0,
        "height_px": 780.0,
        "eps_px": 2.0
      },
      "timeout_frames": 240
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-component" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.slot.0" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "invalid": "true"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "required": false
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-invalid.input" },
        "text": "000000"
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-input-otp-invalid-semantics"
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "required_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "required": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "invalid_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "invalid": null
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "action": "set_value",
        "enabled": true
      }
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form-label" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "123456" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.input" },
        "text": "123456"
      },
      "timeout_frames": 240
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "selected_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-form.slot.5" },
        "selected": true
      }
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-input-otp-required-semantics"
    },
    { "type": "capture_bundle", "label": "ui-gallery-input-otp-invalid-required-semantics" }
  ]
}
