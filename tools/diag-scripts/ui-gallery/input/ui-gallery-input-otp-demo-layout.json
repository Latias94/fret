{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-input-otp-demo-layout",
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "tags": ["ui-gallery", "shadcn", "input-otp", "demo", "layout"],
    "target_hints": [
      "Navigates to the Input OTP page and captures the docs-path Demo slot geometry.",
      "Keeps the comparison on slot/group/separator relative geometry because the upstream input-otp hidden input spans the viewport.",
      "Feeds the v2 parity-discovery sweep with stable test-id anchors instead of pixel coordinates."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "press_key", "key": "escape" },
    { "type": "wait_frames", "n": 2 },
    { "type": "set_window_inner_size", "width_px": 1440.0, "height_px": 900.0 },
    { "type": "wait_frames", "n": 10 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "button": "left"
    },
    {
      "type": "press_key",
      "key": "a",
      "modifiers": { "ctrl": true, "alt": false, "meta": false, "shift": false },
      "repeat": false
    },
    {
      "type": "press_key",
      "key": "backspace",
      "modifiers": { "ctrl": false, "alt": false, "meta": false, "shift": false },
      "repeat": false
    },
    { "type": "type_text", "text": "input otp" },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-input-otp" },
      "delta_y": -240.0,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-input-otp" }
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-page-input-otp" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-otp-demo" },
      "delta_y": -180.0,
      "require_fully_within_container": true,
      "require_fully_within_window": true,
      "padding_px": 24.0,
      "timeout_frames": 900
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-input-otp-simple.slot.0" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_bounds_stable",
      "target": { "kind": "test_id", "id": "ui-gallery-input-otp-simple.slot.0" },
      "stable_frames": 6,
      "max_move_px": 1.0,
      "timeout_frames": 600
    },
    { "type": "capture_layout_sidecar", "label": "ui-gallery-input-otp-demo.layout" },
    { "type": "capture_screenshot", "label": "ui-gallery-input-otp-demo" },
    { "type": "capture_bundle", "label": "ui-gallery-input-otp-demo" }
  ]
}
