{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-input-demo-relation-action-state",
    "required_capabilities": ["diag.script_v2"],
    "env_defaults": {
      "FRET_UI_GALLERY_START_PAGE": "input"
    },
    "tags": ["ui_gallery", "shadcn", "input", "semantics", "action-state"],
    "target_hints": [
      "Starts directly on the Input page.",
      "Locks the docs-demo Input control's editable action state, focus behavior, and value update."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-theme-preset-trigger" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-input" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-demo-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "role_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" },
        "role": "text_field"
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" },
        "action": "focus",
        "enabled": true
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "semantics_action_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" },
        "action": "set_value",
        "enabled": true
      }
    },
    { "type": "click_stable", "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" }
      },
      "timeout_frames": 240
    },
    { "type": "type_text", "text": "sk-test" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_equals",
        "target": { "kind": "test_id", "id": "ui-gallery-input-demo-control" },
        "text": "sk-test"
      },
      "timeout_frames": 240
    },
    { "type": "capture_layout_sidecar", "label": "ui-gallery-input-demo-relation-action-state.layout" },
    { "type": "capture_bundle", "label": "ui-gallery-input-demo-relation-action-state" }
  ]
}
