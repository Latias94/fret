{
  "schema_version": 2,
  "meta": {
    "name": "ui-gallery-input-basic-and-file-long-text",
    "required_capabilities": [
      "diag.script_v2",
      "diag.screenshot_png"
    ],
    "tags": ["ui_gallery", "shadcn", "input", "file", "text_input", "long_text"],
    "target_hints": [
      "Navigates to the Input page through the stable UI Gallery nav path.",
      "Injects long values into a plain Input and the file-composition Input.",
      "Asserts TextInput paint-time overflow, offset, visible viewport clipping, IME cursor bounds, and text-height coverage."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-nav-search" }
      },
      "timeout_frames": 600
    },
    { "type": "set_window_inner_size", "width_px": 760.0, "height_px": 700.0 },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "type_text_into",
      "target": { "kind": "test_id", "id": "ui-gallery-nav-search" },
      "text": "input",
      "clear_before_type": true,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 2 },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-nav-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-nav-input" },
      "delta_y": -240.0,
      "timeout_frames": 600
    },
    { "type": "click_stable", "target": { "kind": "test_id", "id": "ui-gallery-nav-input" } },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "ui-gallery-input" }
      },
      "timeout_frames": 600
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-basic-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-input-basic-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-input-basic-control" },
      "text": "plain-input-observability-contract-with-a-very-long-searchable-value",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_len_ge",
        "target": { "kind": "test_id", "id": "ui-gallery-input-basic-control" },
        "min_len_bytes": 68
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_ime_cursor_area_within_bounds",
        "target": { "kind": "test_id", "id": "ui-gallery-input-basic-control" },
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_overflow_is",
        "overflowing": true,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_offset_in_range",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_visible_text_within_viewport",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_viewport_covers_text_height",
        "eps_px": 1.0
      }
    },
    {
      "type": "scroll_into_view",
      "container": { "kind": "test_id", "id": "ui-gallery-content-scroll" },
      "target": { "kind": "test_id", "id": "ui-gallery-input-file-section-content" },
      "delta_y": -120.0,
      "require_fully_within_window": true,
      "padding_px": 16.0,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "bounds_within_window",
        "target": { "kind": "test_id", "id": "ui-gallery-input-file-control" },
        "padding_px": 8.0,
        "eps_px": 1.0
      },
      "timeout_frames": 600
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "ui-gallery-input-file-control" },
      "text": "enterprise-observability-capture-session-with-render-snapshots-and-long-file-name.png",
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 8 },
    {
      "type": "assert",
      "predicate": {
        "kind": "value_len_ge",
        "target": { "kind": "test_id", "id": "ui-gallery-input-file-control" },
        "min_len_bytes": 80
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_ime_cursor_area_within_bounds",
        "target": { "kind": "test_id", "id": "ui-gallery-input-file-control" },
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_overflow_is",
        "overflowing": true,
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_horizontal_offset_in_range",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_visible_text_within_viewport",
        "eps_px": 1.0
      }
    },
    {
      "type": "assert",
      "predicate": {
        "kind": "text_input_viewport_covers_text_height",
        "eps_px": 1.0
      }
    },
    {
      "type": "capture_layout_sidecar",
      "label": "ui-gallery-input-basic-and-file-long-text.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "ui-gallery-input-basic-and-file-long-text"
    },
    { "type": "capture_bundle", "label": "ui-gallery-input-basic-and-file-long-text" }
  ]
}
