{
  "schema_version": 2,
  "meta": {
    "name": "cookbook imui plot: smoke",
    "tags": ["cookbook", "cookbook.imui_plot_basics", "imui", "plot", "screenshots"],
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "required_launch_features": ["cookbook-diag", "cookbook-imui-plot"],
    "target_hints": [
      "Waits for the IMUI plot lesson root, panel, and model-output readouts.",
      "Captures screenshot and bundle evidence so startup/theme regressions fail deterministically."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "set_window_inner_size", "width_px": 920.0, "height_px": 640.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_plot_basics.root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_plot_basics.panel" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "cookbook.imui_plot_basics.view" },
        "text": "View: x="
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "cookbook.imui_plot_basics.cursor" },
        "text": "Cursor:"
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 12 },
    { "type": "capture_screenshot", "label": "cookbook-imui-plot-basics-smoke" },
    { "type": "capture_bundle", "label": "cookbook-imui-plot-basics-smoke" }
  ]
}
