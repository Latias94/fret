{
  "schema_version": 2,
  "meta": {
    "name": "cookbook imui editor controls: click stress",
    "tags": [
      "cookbook",
      "cookbook.imui_editor_controls_basics",
      "imui",
      "editor-controls",
      "stress",
      "overlay"
    ],
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "required_launch_features": ["cookbook-diag", "cookbook-imui"],
    "target_hints": [
      "Exercises the manual path that repeatedly opens and dismisses editor-control overlays.",
      "Covers text assist open/dismiss/reopen, option accept, roughness typing, search focus, and color popup open/dismiss.",
      "Resets diagnostics after the cookbook root settles so startup resize/header measurement does not pollute the interaction window."
    ]
  },
  "steps": [
    { "type": "set_window_inner_size", "width_px": 1000.0, "height_px": 700.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.root" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 8 },
    { "type": "reset_diagnostics" },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist.list" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.summary" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "not_exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist.list" }
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "set_text_value",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist" },
      "text": "ca"
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist.list" }
      },
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": {
        "kind": "test_id",
        "id": "cookbook.imui_editor_controls.assist.item.item.camera"
      },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "value_contains",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.assist" },
        "text": "Camera"
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.roughness" },
      "button": "left",
      "click_count": 2,
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "focus_is",
        "target": {
          "kind": "test_id",
          "id": "cookbook.imui_editor_controls.roughness.typing.input"
        }
      },
      "timeout_frames": 240
    },
    {
      "type": "set_text_value",
      "target": {
        "kind": "test_id",
        "id": "cookbook.imui_editor_controls.roughness.typing.input"
      },
      "text": "61"
    },
    { "type": "press_key", "key": "enter" },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.roughness.value" },
        "text": "61%"
      },
      "timeout_frames": 240
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.search" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.tint" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 12 },
    {
      "type": "click_stable",
      "target": { "kind": "test_id", "id": "cookbook.imui_editor_controls.summary" },
      "button": "left",
      "stable_frames": 8,
      "max_move_px": 0.5,
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 20 },
    {
      "type": "capture_layout_sidecar",
      "label": "cookbook-imui-editor-controls-click-stress.layout"
    },
    {
      "type": "capture_screenshot",
      "label": "cookbook-imui-editor-controls-click-stress"
    },
    {
      "type": "capture_bundle",
      "label": "cookbook-imui-editor-controls-click-stress"
    }
  ]
}
