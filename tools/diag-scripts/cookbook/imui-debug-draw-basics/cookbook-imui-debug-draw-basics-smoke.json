{
  "schema_version": 2,
  "meta": {
    "name": "cookbook imui debug draw: smoke",
    "tags": ["cookbook", "cookbook.imui_debug_draw_basics", "imui", "debug-draw", "screenshots"],
    "required_capabilities": ["diag.script_v2", "diag.screenshot_png"],
    "required_launch_features": ["cookbook-diag", "cookbook-imui"],
    "target_hints": [
      "Waits for the IMUI debug-draw root, canvas, metadata, and response anchors to exist.",
      "Captures a screenshot and bundle for reviewable draw-list evidence."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "set_window_inner_size", "width_px": 1000.0, "height_px": 640.0 },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_debug_draw.root" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_debug_draw.canvas" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_debug_draw.summary.list" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_debug_draw.summary.commands" }
      },
      "timeout_frames": 600
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "exists",
        "target": { "kind": "test_id", "id": "cookbook.imui_debug_draw.summary.response" }
      },
      "timeout_frames": 600
    },
    { "type": "wait_frames", "n": 30 },
    { "type": "capture_screenshot", "label": "cookbook-imui-debug-draw-basics-smoke" },
    { "type": "capture_bundle", "label": "cookbook-imui-debug-draw-basics-smoke" }
  ]
}
