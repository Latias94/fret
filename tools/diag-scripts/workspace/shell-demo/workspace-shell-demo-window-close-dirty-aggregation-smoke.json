{
  "schema_version": 2,
  "meta": {
    "name": "Workspace shell demo: window close dirty aggregation (smoke)",
    "tags": ["workspace", "window", "dirty", "close", "prompt", "aggregation", "smoke", "gate"],
    "required_capabilities": ["diag.script_v2", "diag.command_dispatch_trace"],
    "env_defaults": {
      "FRET_WORKSPACE_SHELL_DEBUG_PREVIEW": "1",
      "FRET_WORKSPACE_SHELL_DEBUG_DIRTY_CLOSE_POLICY": "1"
    },
    "target_hints": [
      "Marks the active tab in pane-a and the active tab in pane-b dirty.",
      "Invokes the real window.close command from the debug UI.",
      "Asserts the dirty-close prompt aggregates dirty tabs across panes and Cancel preserves the window."
    ]
  },
  "steps": [
    { "type": "reset_diagnostics" },
    { "type": "set_window_inner_size", "width_px": 1280.0, "height_px": 720.0 },
    { "type": "wait_frames", "n": 10 },

    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-tab-doc-a-2" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-b-tab-doc-b-1" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-debug-close-window" } },
      "timeout_frames": 240
    },

    { "type": "click_stable", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-debug-mark-dirty" } },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-tab-doc-a-2.dirty" } },
      "timeout_frames": 240
    },

    { "type": "click_stable", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-debug-mark-pane-b-dirty" } },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-b-tab-doc-b-1.dirty" } },
      "timeout_frames": 240
    },

    { "type": "reset_diagnostics" },
    { "type": "click_stable", "target": { "kind": "test_id", "id": "workspace-shell-debug-close-window" } },
    {
      "type": "wait_command_dispatch_trace",
      "query": {
        "command": "window.close",
        "handled": true,
        "source_kind": "pointer",
        "source_test_id": "workspace-shell-debug-close-window"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "workspace-shell-dirty-close-prompt" },
        "text": "reason=CloseWindow active=doc-a-2 close_count=5"
      },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": {
        "kind": "label_contains",
        "target": { "kind": "test_id", "id": "workspace-shell-dirty-close-prompt" },
        "text": "dirty=[doc-a-2, doc-b-1]"
      },
      "timeout_frames": 240
    },

    { "type": "click_stable", "target": { "kind": "test_id", "id": "workspace-shell-dirty-close-prompt.cancel" } },
    {
      "type": "wait_until",
      "predicate": { "kind": "not_exists", "target": { "kind": "test_id", "id": "workspace-shell-dirty-close-prompt" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-root" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-b-root" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-a-tab-doc-a-2.dirty" } },
      "timeout_frames": 240
    },
    {
      "type": "wait_until",
      "predicate": { "kind": "exists", "target": { "kind": "test_id", "id": "workspace-shell-pane-pane-b-tab-doc-b-1.dirty" } },
      "timeout_frames": 240
    },

    { "type": "capture_bundle", "label": "workspace-shell-demo-window-close-dirty-aggregation-smoke" }
  ]
}
