{
  "schema_version": 1,
  "suite_id": "fret-ui.roving-focus-interaction.mechanism-harness-v1",
  "owner_layer": "crates/fret-ui",
  "domains": ["focus"],
  "cases": [
    {
      "id": "arrow-down-skips-disabled-item",
      "scenario": {
        "kind": "roving_flex",
        "wrap": true,
        "disabled": [false, true, false],
        "initial": "a",
        "key": "arrow_down"
      },
      "oracle": {
        "predicates": [
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "focus_is",
              "target": { "kind": "test_id", "id": "roving-c" }
            }
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "roving.selection.index",
            "comparison": "eq",
            "value": 2.0,
            "eps": 0.0
          }
        ]
      },
      "evidence": {
        "upstream_ref": "Radix roving focus skips disabled items",
        "note": "Arrow navigation must skip disabled entries while updating active selection state."
      }
    },
