    {
      "id": "typeahead-key-targets-third-item",
      "scenario": {
        "kind": "roving_flex",
        "wrap": true,
        "disabled": [false, false, false],
        "initial": "a",
        "key": "key_c",
        "typeahead": { "target": "c" }
      },
      "oracle": {
        "predicates": [
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "focus_is",
              "target": { "kind": "test_id", "id": "roving-c" }
            }
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "roving.selection.index",
            "comparison": "eq",
            "value": 2.0,
            "eps": 0.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "roving.typeahead.calls",
            "comparison": "eq",
            "value": 1.0,
            "eps": 0.0
          }
        ]
      },
      "evidence": {
        "upstream_ref": "APG composite widgets can use printable character typeahead to move active focus",
        "note": "The mechanism must route printable keys to the component typeahead hook and update focus/selection exactly once."
      }
    },
