    {
      "id": "text-input-region-value-and-editing-metadata",
      "scenario": { "kind": "text_input_region_value_and_editing_metadata" },
      "oracle": {
        "predicates": [
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "role_is",
              "target": { "kind": "test_id", "id": "editor-region" },
              "role": "text_field"
            }
          },
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "value_equals",
              "target": { "kind": "test_id", "id": "editor-region" },
              "text": "hello"
            }
          },
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "text_composition_is",
              "target": { "kind": "test_id", "id": "editor-region" },
              "composing": true
            }
          },
          {
            "kind": "semantics_text_selection_is",
            "target": { "kind": "test_id", "id": "editor-region" },
            "expected": { "anchor": 2, "focus": 2 }
          },
          {
            "kind": "semantics_text_composition_range_is",
            "target": { "kind": "test_id", "id": "editor-region" },
            "expected": { "start": 1, "end": 3 }
          },
          {
            "kind": "semantics_action_is",
            "target": { "kind": "test_id", "id": "editor-region" },
            "action": "focus",
            "expected": true
          },
          {
            "kind": "semantics_action_is",
            "target": { "kind": "test_id", "id": "editor-region" },
            "action": "set_value",
            "expected": false
          },
          {
            "kind": "semantics_action_is",
            "target": { "kind": "test_id", "id": "editor-region" },
            "action": "set_text_selection",
            "expected": true
          }
        ]
      },
      "evidence": {
        "upstream_ref": "ADR 0071 text selection/composition semantics",
        "note": "TextInputRegion publishes value and editing ranges only while focused; mechanism harness must be able to observe and assert that surface."
      }
    },
