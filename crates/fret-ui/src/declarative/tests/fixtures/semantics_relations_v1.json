      "id": "text-input-controls-element-resolves-to-listbox",
      "scenario": { "kind": "text_input_controls_element" },
      "oracle": {
        "predicates": [
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "role_is",
              "target": { "kind": "test_id", "id": "combo" },
              "role": "combo_box"
            }
          },
          {
            "kind": "semantics_relation_includes",
            "source": { "kind": "test_id", "id": "combo" },
            "relation": "controls",
            "target": { "kind": "test_id", "id": "listbox" }
          }
        ]
      },
      "evidence": {
        "upstream_ref": "ARIA combobox aria-controls relation",
        "note": "TextInputProps.controls_element must resolve declarative element ids into semantics NodeIds."
      }
    },
