{
  "schema_version": 1,
  "suite_id": "fret-ui.prepaint-virtual-list-window-update.v1",
  "owner_layer": "crates/fret-ui",
  "domains": ["invalidation", "layout"],
  "cases": [
    {
      "id": "scroll-offset-escape-non-retained",
      "scenario": {
        "kind": "virtual_list_prepaint",
        "len": 1000,
        "items_revision": 1,
        "state_items_revision": 1,
        "viewport_height": 40.0,
        "state_viewport_height": 40.0,
        "row_height": 10.0,
        "overscan": 10,
        "scroll_offset_y": 620.0,
        "state_offset_y": 0.0,
        "render_window": { "start_index": 0, "end_index": 20 }
      },
      "oracle": {
        "predicates": [
          {
            "kind": "mechanism_metric",
            "metric_id": "prepaint.window_shift.kind.escape",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "prepaint.window_shift.reason.scroll_offset",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "prepaint.window_shift.invalidation_detail.scroll_handle_window_update",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "cache_root.dirty_reason.scroll_handle_window_update",
            "comparison": "eq",
            "value": 1.0
          }
        ]
      },
      "evidence": {
        "note": "A scroll offset that escapes the rendered window should be classified as a non-retained rerender with the generic scroll-window-update detail."
      }
    },
