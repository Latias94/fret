{
  "schema_version": 1,
  "suite_id": "fret-ui.scroll-handle-invalidation.v1",
  "owner_layer": "crates/fret-ui",
  "domains": ["layout", "invalidation"],
  "cases": [
    {
      "id": "windowed-scroll-offset-change-repaints-cache-root-without-rerender",
      "scenario": {
        "kind": "tree",
        "root": "root",
        "nodes": [
          { "id": "root", "children": ["cache_root"] },
          { "id": "cache_root", "children": ["scroll"] },
          { "id": "scroll" }
        ],
        "handles": [{ "id": "main", "kind": "scroll" }],
        "steps": [
          {
            "op": "set_view_cache_flags",
            "node": "cache_root",
            "enabled": true,
            "layout_contained_when_bounds_known": true,
            "layout_definite": true
          },
          { "op": "set_bounds_all", "width": 100.0, "height": 100.0 },
          {
            "op": "register_scroll_surface",
            "node": "scroll",
            "element_id": 10,
            "handle": "main",
            "surface": { "kind": "scroll", "windowed_paint": true }
          },
          { "op": "invalidate_scroll_handles" },
          { "op": "clear_all_invalidations" },
          { "op": "set_debug_baseline" },
          { "op": "set_scroll_offset", "handle": "main", "x": 0.0, "y": 250.0 },
          { "op": "invalidate_scroll_handles" },
          { "op": "capture_metrics", "label": "after_scroll" }
        ]
      },
      "oracle": {
        "predicates": [
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.node.cache_root.view_cache_needs_rerender",
            "comparison": "eq",
            "value": 0.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.node.cache_root.should_reuse_view_cache",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.node.cache_root.paint_dirty",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.node.scroll.hit_test_dirty",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.debug.scroll_handle_changes_since_baseline.offset_changed_count",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.node.cache_root.dirty_cache_root",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.debug.invalidation_walks_since_baseline.inv.paint_count",
            "comparison": "eq",
            "value": 1.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "capture.after_scroll.debug.invalidation_walks_since_baseline.detail.scroll_handle_window_update_count",
            "comparison": "eq",
            "value": 1.0
          }
        ]
      },
      "evidence": {
        "note": "Windowed scroll paint depends on the current scroll offset; an external offset change must invalidate paint-cache replay without forcing the reusable cache root to rerender."
      }
    },
    {
      "id": "windowed-scroll-revision-only-after-internal-offset-stays-reusable",
      "scenario": {
        "kind": "tree",
        "root": "root",
        "nodes": [
          { "id": "root", "children": ["cache_root"] },
          { "id": "cache_root", "children": ["scroll"] },
          { "id": "scroll" }
        ],
        "handles": [{ "id": "main", "kind": "scroll" }],
        "steps": [
          {
            "op": "set_view_cache_flags",
            "node": "cache_root",
            "enabled": true,
            "layout_contained_when_bounds_known": true,
            "layout_definite": true
          },
          { "op": "set_bounds_all", "width": 100.0, "height": 100.0 },
          {
            "op": "register_scroll_surface",
            "node": "scroll",
            "element_id": 11,
            "handle": "main",
            "surface": { "kind": "scroll", "windowed_paint": true }
          },
          { "op": "invalidate_scroll_handles" },
          { "op": "clear_all_invalidations" },
          {
            "op": "set_scroll_offset",
            "handle": "main",
