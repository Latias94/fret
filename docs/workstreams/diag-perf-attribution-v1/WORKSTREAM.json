  "repro": {
    "summary": "Use diag perf to create a bundle, then inspect stats, triage, diffs, hints, and trace artifacts from that same evidence root.",
    "commands": [
      "cargo run -p fretboard-dev -- diag perf ui-gallery-steady --repeat 1 --trace --launch -- cargo run -p fret-ui-gallery --release",
      "cargo run -p fretboard-dev -- diag stats <bundle.json> --sort time --top 30",
      "cargo run -p fretboard-dev -- diag trace <bundle.json>",
      "use the DevTools selected-summary trace follow-up for a failing bundle_dir"
    ]
  },
