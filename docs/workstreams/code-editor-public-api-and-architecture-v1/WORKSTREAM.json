  "repro": {
    "summary": "Start from a source-backed public-surface audit of the code editor crates and the existing editor perf contracts before changing public APIs or adding feature surfaces.",
    "commands": [
      "python tools/audit_crate.py --crate fret-code-editor",
      "rg -n \"pub (struct|enum|trait|type|fn)|pub use|pub mod\" ecosystem/fret-code-editor/src ecosystem/fret-code-editor-buffer/src ecosystem/fret-code-editor-view/src",
      "rg -n \"0185|code editor ecosystem v1|fret-code-editor\" docs/adr docs/workstreams -g \"*.md\""
    ]
  },
  "gates": [
    {
      "name": "json shape",
      "command": "python -m json.tool docs/workstreams/code-editor-public-api-and-architecture-v1/WORKSTREAM.json"
    },
    {
      "name": "workstream catalog",
      "command": "python tools/check_workstream_catalog.py"
    },
    {
      "name": "diff hygiene",
      "command": "git diff --check"
    },
    {
      "name": "code editor view format",
      "command": "cargo fmt -p fret-code-editor-view --check"
    },
    {
      "name": "code editor view check",
      "command": "cargo check -p fret-code-editor-view"
    },
    {
      "name": "code editor view tests",
      "command": "cargo nextest run -p fret-code-editor-view --lib --no-fail-fast"
    },
    {
      "name": "code editor buffer format",
      "command": "cargo fmt -p fret-code-editor-buffer --check"
    },
    {
      "name": "code editor buffer check",
      "command": "cargo check -p fret-code-editor-buffer"
    },
    {
      "name": "code editor buffer tests",
      "command": "cargo nextest run -p fret-code-editor-buffer --lib --no-fail-fast"
    },
    {
      "name": "code editor format",
      "command": "cargo fmt -p fret-code-editor --check"
    },
    {
      "name": "code editor syntax feature check",
      "command": "cargo check -p fret-code-editor --features syntax-rust"
    },
    {
      "name": "code editor command availability tests",
      "command": "cargo nextest run -p fret-code-editor command_availability --lib --features syntax --no-fail-fast"
    },
    {
      "name": "code editor text undo redo alias tests",
      "command": "cargo nextest run -p fret-code-editor text_undo_redo --lib --features syntax --no-fail-fast"
    },
    {
      "name": "code editor focused tests",
      "command": "cargo nextest run -p fret-code-editor --lib --features syntax --no-fail-fast"
    },
    {
      "name": "code editor public surface test",
      "command": "cargo nextest run -p fret-code-editor --test public_surface --no-fail-fast"
    },
    {
      "name": "code editor feature payload tests",
      "command": "cargo nextest run -p fret-code-editor feature_payload --no-fail-fast"
    },
    {
      "name": "ui gallery check",
      "command": "cargo check -p fret-ui-gallery"
    },
    {
      "name": "ui gallery code editor overlay hook gate",
      "command": "cargo nextest run -p fret-ui-gallery --features gallery-dev code_editor_torture_assist_overlay_hook_stays_within_window --no-fail-fast"
    },
    {
      "name": "feature payload bundle stats gate",
      "command": "cargo run -p fretboard -- diag stats <bundle.schema2.json> --warmup-frames 5 --check-ui-gallery-code-editor-torture-feature-payloads-stable"
    },
    {
      "name": "layering",
      "command": "python tools/check_layering.py"
    }
  ],
