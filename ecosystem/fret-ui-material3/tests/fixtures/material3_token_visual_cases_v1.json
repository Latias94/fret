      "component": "button",
      "scheme": { "mode": "light", "variant": "tonal_spot" },
      "input": { "variant": "filled", "enabled": true, "interaction": "none" },
      "assertions": [
        { "role": "label_color", "kind": "color", "token": "md.comp.button.filled.label-text.color" },
        { "role": "container_color", "kind": "color", "token": "md.comp.button.filled.container.color" },
        { "role": "icon_color", "kind": "color", "token": "md.comp.button.filled.icon.color" },
        { "role": "container_elevation", "kind": "metric", "token": "md.comp.button.filled.container.elevation" },
        { "role": "shadow_color", "kind": "color", "token": "md.comp.button.filled.container.shadow-color" },
        { "role": "theme_text_style", "kind": "text_style_alias", "token": "md.comp.button.label-text", "source_token": "md.sys.typescale.label-large" }
      ]
    },
    {
