{
  "schema_version": 1,
  "suite": "material3-api-doc-surface-v1",
  "notes": "Structured documentation surface for public Material3 recipe APIs. Families map proof-manifest entries to crate-level and README guidance; style_surfaces and copyable_state_sources keep the shadcn-level authoring model visible and testable.",
  "required_crate_doc_terms": [
    "Design-system boundary",
    "Authoring model",
    "Controlled and copyable state",
    "Action-first pressables",
    "Style overrides",
    "Automation IDs",
    "Icons",
    "Component families",
    "Proof surface",
    "material3_recipe_proof_manifest_v1.json",
    "new_controllable(cx, ...)",
    "uncontrolled(cx)",
    "*_model()",
    ".test_id(...)"
  ],
  "required_readme_terms": [
    "Public authoring model",
    "Controlled and copyable state",
    "Action-first pressables",
    "Style overrides",
    "Automation IDs",
