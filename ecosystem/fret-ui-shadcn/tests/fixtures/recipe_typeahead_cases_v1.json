      "oracle": {
        "predicates": [
          {
            "kind": "ui_predicate",
            "predicate": {
              "kind": "focus_is",
              "target": { "kind": "test_id", "id": "select-trigger" }
            }
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "recipe.open",
            "comparison": "eq",
            "value": 0.0,
            "eps": 0.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "select.selected.index",
            "comparison": "eq",
            "value": 1.0,
            "eps": 0.0
          },
          {
            "kind": "mechanism_metric",
            "metric_id": "select.value_change.calls",
            "comparison": "eq",
            "value": 1.0,
            "eps": 0.0
          }
        ]
      },
      "evidence": {
        "upstream_ref": "Radix Select trigger typeahead updates selection without opening",
        "note": "Closed trigger typeahead should update the selected value while keeping the popup closed."
      }
    },
